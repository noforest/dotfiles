# === nvim ====================================================================
# One single change cannot be expressed as configuration. The patch header
# explains which one. Everything else lives in lazy.lua.
# yazi plugins and flavors are not tracked: package.toml pins each one by rev and
# hash, and this restores them from it. Keeping the vendored trees out of the repo
# is what lets `ya pkg upgrade` own that directory without fighting `dot link`.
cmd_yazi_plugins() {
    head_ "yazi plugins"
    if ! command -v ya >/dev/null; then
        warn "ya not installed, skipping (install the 'yazi' package first)"
        return 0
    fi
    local manifest="$MODULES/desktop/.config/yazi/package.toml"
    if [ ! -e "$manifest" ]; then
        warn "no package.toml, nothing to restore"
        return 0
    fi
    ya pkg install && ok "plugins and flavors restored from package.toml"
}

# The nvim config fetches its plugins, its language servers and its treesitter
# parsers by itself, but only once nvim runs with a window, in the background,
# and it fails one tool at a time when something is missing. This does all of it
# up front, so that the first nvim a new machine opens is ready and silent.
# Every tool it checks for comes from packages/<distro>/nvim.txt.
cmd_nvim_setup() {
    head_ "nvim-setup"
    if ! command -v nvim >/dev/null; then
        warn "nvim not installed, skipping (dot install first)"
        return 0
    fi
    nvim --headless -c 'lua if vim.fn.has("nvim-0.12") == 0 then vim.cmd("cquit 1") end' +qall >/dev/null 2>&1 \
        || die "nvim $(nvim --version | head -1 | cut -d' ' -f2) is too old, the config needs 0.12 or newer$(
            [ "$(distro)" = arch ] || printf ' (scripts/ubuntu-install-neovim.sh)')"

    # command:what it is for. fd is `fdfind` on Debian, either name will do.
    local need missing="" cmd
    for need in git:plugins curl:mason unzip:mason cc:treesitter-parsers tree-sitter:treesitter-parsers \
                node:typescript-server npm:typescript-server python3:pyrefly go:sqls java:jdtls \
                rustc:rust_analyzer rg:telescope; do
        cmd=${need%%:*}
        command -v "$cmd" >/dev/null || missing="$missing $cmd(${need#*:})"
    done
    command -v fd >/dev/null || command -v fdfind >/dev/null || missing="$missing fd(snacks)"
    # Debian ships venv apart from python3, and mason installs pyrefly in one
    python3 -c 'import venv, ensurepip' 2>/dev/null || missing="$missing python3-venv(pyrefly)"
    if [ -n "$missing" ]; then
        err "missing:$missing"
        info "  ${D}They are listed in packages/$(distro)/nvim.txt: dot install${N}"
        return 1
    fi
    ok "tools present"

    # Restoring to a lock that nvim rewrote on this machine pins nothing.
    local lock="modules/nvim/.config/nvim/lazy-lock.json"
    git -C "$REPO" diff --quiet -- "$lock" \
        || warn "lazy-lock.json differs from the committed one, plugins follow the local copy ${D}(dotgit restore $lock)${N}"
    info "  ${D}plugins: nvim --headless +Lazy! restore${N}"
    nvim --headless "+Lazy! restore" +qall >/dev/null 2>&1 || warn "lazy.nvim reported an error, open nvim and run :Lazy"
    ok "plugins restored from lazy-lock.json"

    # Loaded from the repository, not with require(): links are per file, so a
    # machine that pulled this module without rerunning dot link does not have it.
    if nvim --headless -c "lua dofile('$MODULES/nvim/.config/nvim/lua/nvim_setup.lua').run()" 2>&1; then
        ok "language servers and treesitter parsers installed"
    else
        err "some servers or parsers could not be installed, see above (rerun: dot nvim-setup)"
        return 1
    fi
}

cmd_nvim_patch() {
    local mode="${1:-apply}" dir="$MODULES/nvim/.config/nvim/patches" lazy="$HOME/.local/share/nvim/lazy"
    head_ "nvim-patch ($mode)"
    [ -d "$dir" ] || { warn "no patch"; return 0; }
    # On a new machine the plugins are not there yet, and a patch needs them.
    if [ ! -d "$lazy" ] && command -v nvim >/dev/null; then
        info "  ${D}installing the plugins first: nvim --headless +Lazy! install${N}"
        nvim --headless "+Lazy! install" +qa >/dev/null 2>&1 && ok "plugins installed"
    fi
    local p name plug rc=0
    for p in "$dir"/*.patch; do
        [ -e "$p" ] || { warn "no patch"; return 0; }
        name=$(basename "$p" .patch); plug="$lazy/$name"
        [ -d "$plug/.git" ] || { warn "$name: plugin not installed (run nvim, then :Lazy sync)"; continue; }
        if [ "$mode" = "--save" ]; then
            warn "$name: regeneration is disabled, this patch is written by hand and carries an explanation in its header"
        elif git -C "$plug" apply --check --reverse "$p" 2>/dev/null; then
            ok "$name already applied"
        elif git -C "$plug" apply --3way "$p" 2>/dev/null; then
            ok "$name applied"
        else
            err "$name: the patch no longer applies, upstream moved, redo it by hand"
            rc=1
        fi
    done
    return $rc
}

# === services ================================================================
# The units a profile needs running, from its `services:` line. Enabled one by
# one: systemctl enables nothing at all when a single unit is missing, and a
# profile is distribution neutral, so ly for instance does not exist on Ubuntu.
# Without this step a new machine reboots to a console with no network.
cmd_services() {
    local profile="${1:-$DEFAULT_PROFILE}" u
    profile_check "$profile"
    head_ "services ($profile, sudo)"
    local units
    units=$(profile_setting "$profile" services)
    [ -n "$units" ] || { ok "the profile declares no service"; return 0; }
    sudo systemctl daemon-reload
    for u in $units; do
        if ! systemctl cat "$u" >/dev/null 2>&1; then
            warn "$u: not installed, skipped"
        elif sudo systemctl enable "$u" >/dev/null 2>&1; then
            ok "$u enabled"
        else
            err "$u: could not be enabled, try sudo systemctl enable $u"
        fi
    done
}

