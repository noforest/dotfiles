#!/usr/bin/env bash
# dot - dotfiles management (dwm / Arch Linux)
# See README.md for the full procedure.
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
MODULES="$REPO/modules"
PROFILES="$REPO/profiles"
MACHINES="$REPO/machine.d"
FALLBACK_PROFILE=laptop

# The distribution this machine runs, as `ID` from /etc/os-release: arch, ubuntu,
# debian... It selects the package lists and one of the system/ scopes, and is
# never declared in a profile: a machine knows its own distribution, and two
# sources of truth for it would eventually disagree. $DOT_DISTRO overrides it,
# which is the only way to dry run another distribution from here.
distro() {
    [ -n "${DOT_DISTRO:-}" ] && { printf '%s\n' "$DOT_DISTRO"; return 0; }
    [ -r /etc/os-release ] && (. /etc/os-release && printf '%s\n' "${ID:-unknown}")
}

# The profile to use when the command line does not name one, as
# `<profile><TAB><where it comes from>`. Three sources, most explicit first:
#
#   1. machine.d/<hostname>.conf, which a machine writes for itself. NOT
#      versioned: the repository is public and hostnames have no business in it.
#   2. the chassis, so that a tower does not silently inherit the touchpad,
#      backlight and lid rules of a laptop just because the fallback said so.
#   3. FALLBACK_PROFILE, when even the chassis is unknown (a VM says "vm").
#
# The source is carried along because a profile nobody chose deserves to be
# reported as such, especially before system-apply writes into /etc as root.
default_profile() {
    local f="$MACHINES/$(hostname).conf" p
    if [ -r "$f" ]; then
        p=$(grep -vE '^\s*(#|$)' "$f" | head -1 | tr -d ' \t')
        [ -n "$p" ] && { printf '%s\tmachine.d/%s.conf\n' "$p" "$(hostname)"; return 0; }
    fi
    case "$(hostnamectl chassis 2>/dev/null)" in
        desktop|server) printf 'desktop\tchassis\n'; return 0 ;;
        laptop|convertible|tablet|handset) printf 'laptop\tchassis\n'; return 0 ;;
    esac
    printf '%s\tfallback\n' "$FALLBACK_PROFILE"
}
DEFAULT_PROFILE_SOURCE="$(default_profile | cut -f2)"
DEFAULT_PROFILE="$(default_profile | cut -f1)"

# === Output ==================================================================
# TTY is the terminal test taken once, before any pipeline: inside one, a
# command's own stdout is a pipe and says nothing about where the output ends up.
if [ -t 1 ]; then
    TTY=1
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; D=$'\e[2m'; N=$'\e[0m'
else
    TTY=
    R=; G=; Y=; B=; D=; N=
fi
info() { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
err()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; }
head_() { printf '\n%s== %s %s%s\n' "$B" "$*" "$(printf '=%.0s' $(seq 1 $((60 - ${#1})))) " "$N"; }
# A `label   value` line, dim. Long values are wrapped into the value column
# instead of running under the label, so a profile carrying nine modules still
# reads as one field.
kv() {  # kv <label> <value>
    local label="$1" line
    while IFS= read -r line; do
        printf '  %s%-9s%s%s\n' "$D" "$label" "$line" "$N"
        label=""
    done < <(printf '%s\n' "$2" | fold -s -w 60 | sed 's/[[:space:]]*$//')
}
die()  { err "$*"; exit 1; }

# === Profiles and modules ====================================================
# profile_modules runs inside a process substitution, where die() only exits the
# subshell. Commands therefore validate the profile up front, so an unknown name
# exits non zero instead of reporting an error and returning success.
profile_check() {
    local p="${1:-$DEFAULT_PROFILE}"
    [ -f "$PROFILES/$p.conf" ] || die "unknown profile: $p (available: $(ls "$PROFILES" | sed 's/\.conf//' | tr '\n' ' '))"
}

profile_modules() {
    local p="${1:-$DEFAULT_PROFILE}" f="$PROFILES/${1:-$DEFAULT_PROFILE}.conf"
    [ -f "$f" ] || die "unknown profile: $p (available: $(ls "$PROFILES" | sed 's/\.conf//' | tr '\n' ' '))"
    # Lines shaped `key: value` are settings. Everything else is a module name.
    grep -vE '^\s*(#|$)' "$f" | grep -v ':' | tr -d ' \t'
}

# The other half of the same grammar: the value of a `key: value` line.
# Empty when the key is absent, so a profile written before the key existed keeps
# working. Used for `system:` and `steps:`.
profile_setting() {  # profile_setting <profile> <key>
    local f="$PROFILES/${1:-$DEFAULT_PROFILE}.conf"
    [ -f "$f" ] || return 0
    sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" "$f" | head -1
}

# Paths claimed by more than one module of the same profile, as `<path><TAB><modules>`.
#
# Several graphical environments are meant to be linked side by side, so their
# modules coexist in one profile and nothing stops two of them from shipping the
# same ~/.something. Left undetected, cmd_link would simply link the last one and
# status would then report "link points elsewhere" forever, without ever saying
# that two modules disagree.
module_conflicts() {
    local profile="${1:-$DEFAULT_PROFILE}" mod rel
    {
        while read -r mod; do
            while read -r rel; do
                [ -n "$rel" ] && printf '%s\t%s\n' "$rel" "$mod"
            done < <(module_units "$mod")
        done < <(profile_modules "$profile")
    } | awk -F'\t' '
        { owners[$1] = ($1 in owners) ? owners[$1] ", " $2 : $2; n[$1]++ }
        END { for (p in owners) if (n[p] > 1) printf "%s\t%s\n", p, owners[p] }
    ' | sort
}

is_submodule() {  # is_submodule <absolute-path>
    [ -f "$REPO/.gitmodules" ] || return 1
    local rel="${1#"$REPO"/}"
    git -C "$REPO" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
        | awk '{print $2}' | grep -qx "$rel"
}

# Lists the "link units" of a module as paths relative to $HOME.
# A submodule is linked as a whole directory. Everything else is linked file by file.
module_units() {
    local mod="$1" root="$MODULES/$1"
    [ -d "$root" ] || return 0
    _walk() {
        local dir="$1"
        local e
        for e in "$dir"/* "$dir"/.[!.]*; do
            [ -e "$e" ] || continue
            if [ -d "$e" ] && ! [ -L "$e" ]; then
                if is_submodule "$e"; then printf '%s\n' "${e#"$root"/}"; else _walk "$e"; fi
            else
                printf '%s\n' "${e#"$root"/}"
            fi
        done
    }
    _walk "$root"
}

# Runtime state owned by a daemon, which must NEVER become a symlink.
# xfconfd rewrites its XML atomically and watches it through inotify. Linking
# those files into the repo made it loop, which saturated the session D-Bus and
# froze thunar and flameshot. This is state, not configuration.
NEVER_LINK='/\.config/systemd/|/\.config/xfce4/xfconf/|/\.config/dconf/|/\.config/pulse/|/\.local/state/|\.lock$|/savedState\.|/recently-used'

cmd_check_never_link() {  # cmd_check_never_link <relative-path> -> 0 if forbidden
    printf '%s\n' "/$1" | grep -qE "$NEVER_LINK"
}

# === link / unlink ===========================================================
cmd_link() {
    local profile="${1:-$DEFAULT_PROFILE}" stamp created=0 backed=0 already=0
    profile_check "$profile"
    stamp=$(date +%Y%m%d-%H%M%S)
    head_ "link ($profile)"
    local clash
    clash=$(module_conflicts "$profile")
    if [ -n "$clash" ]; then
        err "two modules claim the same path, refusing to link:"
        printf '%s\n' "$clash" | awk -F'\t' -v d="$D" -v z="$N" '{printf "      %s%-40s %s%s\n", d, $1, $2, z}'
        die "move the shared file into a module both can depend on"
    fi
    local mod rel src dst
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            if cmd_check_never_link "$rel"; then
                err "REFUSED (daemon state, not configuration): $rel"
                continue
            fi
            src="$MODULES/$mod/$rel"; dst="$HOME/$rel"
            if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then
                already=$((already+1)); continue
            fi
            mkdir -p "$(dirname "$dst")"
            if [ -e "$dst" ] || [ -L "$dst" ]; then
                mv "$dst" "$dst.bak-$stamp" || { err "could not back up: $rel"; continue; }
                warn "$rel ${D}-> backed up as $(basename "$dst").bak-$stamp${N}"
                backed=$((backed+1))
            fi
            ln -s "$src" "$dst" && created=$((created+1))
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    info ""
    ok "$created link(s) created, $already already in place, $backed backup(s)"
    [ "$backed" -gt 0 ] && info "  ${D}Backups carry the .bak-$stamp suffix. Delete them once you have checked.${N}"
    return 0
}

cmd_unlink() {
    local profile="${1:-$DEFAULT_PROFILE}" n=0 mod rel dst
    profile_check "$profile"
    head_ "unlink ($profile)"
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            dst="$HOME/$rel"
            if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$MODULES/$mod/$rel")" ]; then
                rm "$dst" && n=$((n+1))
            fi
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    ok "$n link(s) removed, the .bak-* files are kept"
}

cmd_list() {
    local profile="${1:-$DEFAULT_PROFILE}" mod
    profile_check "$profile"
    while read -r mod; do module_units "$mod"; done < <(profile_modules "$profile")
}

# === adopt: the everyday command =============================================
# A file lives in exactly one module, and the module decides which profiles carry
# it. The picker therefore shows, for every module, the profiles it reaches.
modules_all() { find "$MODULES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; }

# Profiles from the narrowest to the widest, so the table reads as growing scope.
profiles_by_scope() {
    local f p
    for f in "$PROFILES"/*.conf; do
        [ -e "$f" ] || continue
        p="$(basename "$f" .conf)"
        printf '%s\t%s\n' "$(profile_modules "$p" | wc -l)" "$p"
    done | sort -n | cut -f2
}

module_profiles() {  # module_profiles <module> -> the profiles carrying it
    local mod="$1" p out=""
    while read -r p; do
        profile_modules "$p" | grep -qx "$mod" && out="$out$p "
    done < <(profiles_by_scope)
    printf '%s' "${out% }"
}

# The chosen module goes to stdout, the table to stderr: the caller captures it.
pick_module() {  # pick_module <path> -> module name
    local path="$1" m w=4 i=1 choice p row
    local mods=()
    while read -r m; do
        mods+=("$m")
        [ "${#m}" -gt "$w" ] && w="${#m}"
    done < <(modules_all)
    [ "${#mods[@]}" -gt 0 ] || die "no module in $MODULES"

    printf '\n  Which module should carry %s%s%s?\n\n' "$B" "$path" "$N" >&2
    printf '      %s%-*s  %s%s\n' "$D" "$w" "MODULE" "PROFILES" "$N" >&2
    for m in "${mods[@]}"; do
        row=""
        for p in $(module_profiles "$m"); do
            # The default profile is this machine's, so it deserves to stand out.
            if [ "$p" = "$DEFAULT_PROFILE" ]; then row="$row$B$p$N "; else row="$row$D$p$N "; fi
        done
        printf '  %s%2d)%s %s%-*s%s  %s\n' "$Y" "$i" "$N" "$G" "$w" "$m" "$N" "${row% }" >&2
        i=$((i+1))
    done
    printf '\n  %s%s is this machine default profile.%s\n' "$D" "$B$DEFAULT_PROFILE$N$D" "$N" >&2
    printf '  %sModule [1-%d], q to cancel:%s ' "$D" "${#mods[@]}" "$N" >&2

    read -r choice || { err "no module given: dot adopt <path> [module]"; return 1; }
    case "$choice" in
        q|Q|"")   err "cancelled"; return 1 ;;
        *[!0-9]*) err "not a number: $choice"; return 1 ;;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le "${#mods[@]}" ] || { err "out of range: $choice"; return 1; }
    printf '%s\n' "${mods[$((choice-1))]}"
}

# Moves one file into the module and links it back. Returns 1 on a skip instead
# of exiting, so adopting a directory can carry on past a file it must leave alone.
adopt_one() {  # adopt_one <absolute-file> <module>
    local abs="$1" mod="$2"
    # Two separate `local`s: bash expands every argument of a `local` before assigning
    # any of them, so "$rel" would be read before it exists (and `set -u` would abort).
    local rel="${abs#"$HOME"/}"
    local dst="$MODULES/$mod/$rel"
    if cmd_check_never_link "$rel"; then
        warn "skipped, runtime state owned by a daemon: $rel"; return 1
    fi
    [ -e "$dst" ] && { err "already present in module $mod: $rel"; return 1; }
    mkdir -p "$(dirname "$dst")"
    mv "$abs" "$dst" || { err "move failed: $rel"; return 1; }
    ln -s "$dst" "$abs"
    ok "$rel"
}

# A directory is adopted file by file, never as a whole: module_units lists a
# module back file by file, so a directory-wide symlink would make the next
# `dot link` rename the module own files to .bak-* and leave circular symlinks.
# The directory itself stays a real directory in $HOME, holding the symlinks.
adopt_dir() {  # adopt_dir <absolute-dir> <module>
    local abs="$1" mod="$2" f n=0 skipped=0
    while read -r f; do
        warn "skipped, git repository: ${f%/.git}"
        skipped=$((skipped+1))
    done < <(find "$abs" -name .git -print)
    while read -r f; do
        if [ -L "$f" ]; then
            warn "skipped, already a symlink: ${f#"$HOME"/}"; skipped=$((skipped+1)); continue
        fi
        if adopt_one "$f" "$mod"; then n=$((n+1)); else skipped=$((skipped+1)); fi
    done < <(find "$abs" -name .git -prune -o \( -type f -o -type l \) -print | sort)
    info ""
    ok "$n file(s) adopted, $skipped skipped"
    [ "$n" -gt 0 ]
}

cmd_adopt() {
    local path="${1:-}" mod="${2:-}"
    [ -n "$path" ] || die "usage: dot adopt <path> [module]"
    local abs; abs="$(readlink -f "$path")" || die "path not found: $path"
    [ -e "$abs" ] || die "path not found: $path"
    case "$abs" in "$HOME"/*) ;; *) die "outside of \$HOME: $abs" ;; esac
    [ -L "$path" ] && die "already a symlink: $path"
    [ -n "$mod" ] || { mod="$(pick_module "~/${abs#"$HOME"/}")" || exit 1; }
    [ -d "$MODULES/$mod" ] || die "unknown module: $mod (available: $(modules_all | tr '\n' ' '))"

    head_ "adopt into $mod"
    local rc=0
    if [ -d "$abs" ]; then adopt_dir "$abs" "$mod" || rc=1
    else adopt_one "$abs" "$mod" || rc=1; fi
    if [ "$rc" -eq 0 ]; then
        info "  ${D}-> carried by profiles: $(module_profiles "$mod")${N}"
        info "  ${D}-> remember to commit${N}"
    fi
    return $rc
}

# === status ==================================================================
SECRET_PATTERNS='(^|/)(\.ssh|\.gnupg|\.certs)/|rclone\.conf$|(^|/)\.npmrc$|(^|/)\.netrc$|atuin/config\.toml$|gh/hosts\.yml$|solaar/config\.yaml$|vlcrc$|\.pem$|\.key$|id_rsa|id_ed25519'

# git_bucket <colour> <label> <blurb> <hint>, reading `<letter><TAB><path>` lines
# on stdin. Prints nothing at all when the bucket is empty, so a clean tree stays
# quiet. The letters come from `git diff --name-status`; they are spelled out
# because `dot status` is meant to be readable without knowing git's shorthand.
git_bucket() {
    local colour="$1" label="$2" blurb="$3" hint="$4" lines n
    lines=$(cat)
    [ -n "$lines" ] || return 0
    n=$(printf '%s\n' "$lines" | wc -l)
    printf '  %s%s (%d)%s %s- %s%s\n' "$colour" "$label" "$n" "$N" "$D" "$blurb" "$N"
    printf '%s\n' "$lines" | head -15 | awk -F'\t' -v c="$colour" -v z="$N" '
        {
            w = $1
            if      ($1 == "M")  w = "modified"
            else if ($1 == "A")  w = "added"
            else if ($1 == "D")  w = "deleted"
            else if ($1 == "T")  w = "typechange"
            else if ($1 == "U")  w = "unmerged"
            else if ($1 == "?")  w = "untracked"
            else if ($1 ~ /^R/)  w = "renamed"
            else if ($1 ~ /^C/)  w = "copied"
            p = $2
            if (NF > 2) p = $2 " -> " $3
            printf "      %s%-11s %s%s\n", c, w, p, z
        }'
    [ "$n" -gt 15 ] && info "      ${D}... and $((n - 15)) more${N}"
    info "      ${D}-> $hint${N}"
    return 0
}

# mtime_note <file-a> <file-b> -> `<side>\t<stamp-a>\t<stamp-b>`, where <side> is
# a, b or same. Only ever a hint: git rewrites mtimes on checkout, so right after
# a clone every repo file looks newer than its installed counterpart.
mtime_note() {
    local a b side=same
    a=$(stat -c %Y "$1" 2>/dev/null) || return 1
    b=$(stat -c %Y "$2" 2>/dev/null) || return 1
    [ "$a" -gt "$b" ] && side=a
    [ "$b" -gt "$a" ] && side=b
    printf '%s\t%s\t%s\n' "$side" \
        "$(date -d "@$a" '+%Y-%m-%d %H:%M')" "$(date -d "@$b" '+%Y-%m-%d %H:%M')"
}

cmd_status() {
    local profile="${1:-$DEFAULT_PROFILE}" rc=0
    profile_check "$profile"

    # What this machine is taken to be, and what that selects. Two detections and
    # one profile decide every section below: the distribution picks the package
    # lists and one scope, the profile picks the modules, the other scopes and
    # the package groups. Naming them here, with where each comes from, is what
    # makes the rest of the report readable. A profile that was guessed rather
    # than chosen is worth saying out loud, especially before system-apply
    # writes into /etc as root.
    head_ "machine"
    local psrc="named on the command line"
    [ $# -eq 0 ] && psrc="from $DEFAULT_PROFILE_SOURCE"
    kv "host" "$(hostname), chassis $(hostnamectl chassis 2>/dev/null || echo unknown)"
    if [ -n "${DOT_DISTRO:-}" ]; then
        kv "distro" "$(distro), forced by \$DOT_DISTRO"
    else
        kv "distro" "$(distro), from /etc/os-release"
    fi
    if [ "$psrc" = "from fallback" ]; then
        warn "profile $profile, $psrc (profiles/$profile.conf)"
        kv "" "-> nothing chose it: no machine.d/$(hostname).conf, no chassis"
    else
        kv "profile" "$profile, $psrc (profiles/$profile.conf)"
    fi
    kv "modules" "$(profile_modules "$profile" | tr '\n' ' ')"
    kv "scopes" "$(scopes_annotated "$profile")"
    local empty
    empty=$(scopes_empty "$profile")
    [ -n "$empty" ] && kv "" "-> $empty: no system/<scope>/root/ directory, ships nothing"
    kv "packages" "$(profile_setting "$profile" packages)"
    [ -d "$(PKGDIR)" ] || kv "" "-> packages/$(distro)/ does not exist, nothing to compare with"

    head_ "links ($profile)"
    info "  ${D}dotfiles/modules/<module>/<path>   -- symlink -->   ~/<path>${N}"
    local clash
    clash=$(module_conflicts "$profile")
    if [ -n "$clash" ]; then
        err "claimed by several modules, 'dot link' would refuse:"
        printf '%s\n' "$clash" | awk -F'\t' -v d="$D" -v z="$N" '{printf "      %s%-40s %s%s\n", d, $1, $2, z}'
        rc=1
    fi
    local mod rel dst missing=0 broken=0 foreign=0 linked=0
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            dst="$HOME/$rel"
            if [ -L "$dst" ]; then
                if [ ! -e "$dst" ]; then err "broken link: $rel"; broken=$((broken+1)); rc=1
                elif [ "$(readlink -f "$dst")" = "$(readlink -f "$MODULES/$mod/$rel")" ]; then linked=$((linked+1))
                else warn "link points elsewhere: $rel -> $(readlink "$dst")"; foreign=$((foreign+1)); fi
            elif [ -e "$dst" ]; then
                warn "real file, not linked: $rel"; foreign=$((foreign+1))
            else
                warn "missing from \$HOME: $rel"; missing=$((missing+1))
            fi
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    ok "$linked linked, $missing missing from ~, $foreign blocked, $broken broken"
    if [ $((missing + foreign + broken)) -gt 0 ]; then
        info "  ${D}-> 'dot link' repairs all three, whatever it replaces is kept as .bak-<date>${N}"
    fi

    head_ "system/ vs the root filesystem"
    local f target diverged=0 absent=0 same=0 unreadable=0
    local note side rstamp sstamp repo_newer=0 sys_newer=0
    info "  ${D}dotfiles/system/<scope>/root/<path>   -- copy -->   /<path>${N}"
    local conflicts
    conflicts=$(sys_conflicts "$profile")
    if [ -n "$conflicts" ]; then
        warn "shipped by several scopes, the last one wins:"
        printf '%s\n' "$conflicts" | sed "s/^/      ${D}/;s/\$/${N}/"
    fi
    while read -r f; do
        target="$(sys_target "$f")"
        # `test -e` failing on a directory we may not traverse says nothing about
        # the file. /etc/polkit-1/rules.d is drwxr-x--- root:polkitd on purpose,
        # since its rules describe who may do what, so a file deployed there
        # reads as missing to anyone but root and system-apply gets blamed for
        # work it did correctly.
        #
        # `sudo -n` retries the check as root, but only if a sudo ticket is
        # already open: it never prompts, so `dot status` stays a read only
        # command that runs without a password. Otherwise the file is reported as
        # unverifiable rather than missing.
        if [ ! -e "$target" ] && [ ! -x "$(dirname "$target")" ]; then
            if sudo -n test -e "$target" 2>/dev/null; then
                if sudo -n cmp -s "$f" "$target" 2>/dev/null; then same=$((same+1))
                else err "diverges: $target"; diverged=$((diverged+1)); rc=1; fi
            else
                warn "cannot check without root: $target"
                unreadable=$((unreadable+1))
            fi
        elif [ ! -e "$target" ]; then warn "missing from the system: $target"; absent=$((absent+1))
        elif ! cmp -s "$f" "$target"; then
            err "diverges: $target"
            # Where it comes from in the repo: with several scopes shipping into
            # the same tree, the target path alone does not say which file to edit.
            printf '      %srepo  %s%s\n' "$D" "${f#"$REPO"/}" "$N"
            # Which copy was edited last, so the direction to fix it is obvious.
            if note=$(mtime_note "$f" "$target"); then
                IFS=$'\t' read -r side rstamp sstamp <<<"$note"
                case "$side" in
                    a)  repo_newer=$((repo_newer+1))
                        printf '      %srepo is newer%s   %srepo %s | system %s%s\n' \
                            "$Y" "$N" "$D" "$rstamp" "$sstamp" "$N" ;;
                    b)  sys_newer=$((sys_newer+1))
                        printf '      %ssystem is newer%s %srepo %s | system %s%s\n' \
                            "$Y" "$N" "$D" "$rstamp" "$sstamp" "$N" ;;
                    *)  printf '      %ssame mtime%s      %sboth %s%s\n' \
                            "$D" "$N" "$D" "$rstamp" "$N" ;;
                esac
            fi
            diverged=$((diverged+1)); rc=1
        else same=$((same+1)); fi
    done < <(sys_files "$profile")
    ok "$same identical, $diverged diverging, $absent missing from the system"
    [ "$unreadable" -gt 0 ] && info "  ${D}$unreadable file(s) unverifiable, run a sudo command first then retry${N}"
    if [ "$diverged" -gt 0 ]; then
        if [ "$sys_newer" -eq 0 ] && [ "$repo_newer" -gt 0 ]; then
            info "  ${D}-> the repo holds the newer copy everywhere: 'dot system-apply'${N}"
        elif [ "$repo_newer" -eq 0 ] && [ "$sys_newer" -gt 0 ]; then
            info "  ${D}-> the system holds the newer copy everywhere: 'dot system-pull'${N}"
        else
            info "  ${D}-> 'dot system-pull' to pull them back, 'dot system-apply' to overwrite${N}"
        fi
    fi

    head_ "packages"
    info "  ${D}installed on this machine   vs   dotfiles/packages/<distro>/*.txt${N}"
    local installed
    installed=$(pkg_installed)
    if [ -n "$installed" ]; then
        local catalogued uncat
        catalogued=$(cat "$(PKGDIR)"/*.txt 2>/dev/null | grep -vE '^\s*(#|$)' | sort -u)
        uncat=$(comm -13 <(printf '%s\n' "$catalogued") <(printf '%s\n' "$installed" | sort -u))
        if [ -n "$uncat" ]; then
            warn "$(printf '%s\n' "$uncat" | wc -l) package(s) installed but missing from the lists:"
            printf '%s\n' "$uncat" | head -15 | sed "s/^/      ${D}/;s/\$/${N}/"
            [ "$(printf '%s\n' "$uncat" | wc -l)" -gt 15 ] && info "      ${D}...${N}"
            info "  ${D}-> AUR: 'dot sync'. Official packages: add them manually to packages/$(distro)/<group>.txt${N}"
        else ok "every list is up to date"; fi
    fi

    head_ "secrets"
    info "  ${D}refuses any sensitive file tracked by git inside dotfiles/${N}"
    local leaked
    leaked=$(git -C "$REPO" ls-files 2>/dev/null | grep -E "$SECRET_PATTERNS")
    if [ -n "$leaked" ]; then
        err "SENSITIVE FILES TRACKED BY GIT:"
        printf '%s\n' "$leaked" | sed 's/^/      /'
        info "  ${D}-> git rm --cached <file>, then check .gitignore${N}"
        rc=1
    else ok "no sensitive file is tracked"; fi

    head_ "git"
    info "  ${D}working tree of the dotfiles/ repository itself${N}"
    # A summary only: uncommitted work is normal, so this section never sets rc.
    if git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
        local branch upstream ahead=0 behind=0 staged unstaged untracked
        branch=$(git -C "$REPO" branch --show-current 2>/dev/null)
        upstream=$(git -C "$REPO" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
        if [ -n "$upstream" ]; then
            read -r behind ahead < <(git -C "$REPO" rev-list --left-right --count "$upstream...HEAD" 2>/dev/null)
            info "  ${D}on ${branch:-HEAD}, tracking $upstream${N}"
        else
            info "  ${D}on ${branch:-HEAD}, no upstream${N}"
        fi
        [ "${ahead:-0}"  -gt 0 ] && warn "${ahead} commit(s) ahead of $upstream, never pushed"
        [ "${behind:-0}" -gt 0 ] && warn "${behind} commit(s) behind $upstream, never pulled"

        # The same three buckets as `git status`, queried separately so a file
        # edited after being staged shows up in both, exactly as git reports it.
        staged=$(git -C "$REPO" diff --cached --name-status 2>/dev/null)
        unstaged=$(git -C "$REPO" diff --name-status 2>/dev/null)
        untracked=$(git -C "$REPO" ls-files --others --exclude-standard 2>/dev/null | sed 's/^/?\t/')

        git_bucket "$G" "staged"    "in the index, will go into the next commit" "dotgit commit" <<<"$staged"
        git_bucket "$R" "unstaged"  "edited in the working tree, NOT in the next commit" "dotgit add <file>" <<<"$unstaged"
        git_bucket "$Y" "untracked" "unknown to git, NOT in the next commit" "dotgit add <file>, or add to .gitignore" <<<"$untracked"

        if [ -z "$staged$unstaged$untracked" ]; then
            if [ "${ahead:-0}" -eq 0 ]; then ok "working tree clean, nothing to push"
            else ok "working tree clean"; fi
        fi
    else
        warn "$REPO is not a git repository"
    fi

    return $rc
}

# === system ==================================================================
# system/<scope>/root/ mirrors the real tree: system/common/root/etc/x maps to
# /etc/x. A scope is a reason to deploy a file: the distribution (arch, ubuntu),
# the hardware (laptop, peripherals), the graphical environment (x11-dwm,
# hyprland). Splitting them is what keeps a tower from receiving the touchpad and
# backlight rules of a laptop.
#
# Scope names are free: `dot` never enumerates them. Adding sway means creating
# system/sway/root/ and naming it in a profile, with no change to this script.

# The scopes a profile deploys: common, then the distribution of THIS machine,
# then whatever the profile declares. Order matters, see sys_files.
sys_scopes() {
    local p="${1:-$DEFAULT_PROFILE}" d
    printf 'common\n'
    d=$(distro); [ -n "$d" ] && printf '%s\n' "$d"
    profile_setting "$p" system | tr ' ' '\n' | grep -v '^$'
}

# The active scopes, each tagged with the reason it is active. `common` is always
# there, one scope is the distribution of this machine, the rest come from the
# profile: three different reasons that the bare list does not distinguish.
# One line per reason rather than one flat list, since the reason is the whole
# point: read down the lines and the machine explains itself.
scopes_annotated() {
    local p="${1:-$DEFAULT_PROFILE}" s d tag prev="" group=""
    d=$(distro)
    while read -r s; do
        [ -n "$s" ] || continue
        case "$s" in
            common) tag="always" ;;
            "$d")   tag="distro" ;;
            *)      tag="profile" ;;
        esac
        if [ -n "$prev" ] && [ "$tag" != "$prev" ]; then
            printf '%s (%s)\n' "$group" "$prev"
            group=""
        fi
        group="${group:+$group }$s"
        prev="$tag"
    done < <(sys_scopes "$p")
    [ -n "$group" ] && printf '%s (%s)\n' "$group" "$prev"
}

# Active scopes with no system/<scope>/root/ directory. They are legal and
# silent: a profile may name a scope before it exists, and a distribution
# without a system/<distro>/ ships nothing there. Silence would read as a bug.
scopes_empty() {
    local p="${1:-$DEFAULT_PROFILE}" s out=""
    while read -r s; do
        [ -n "$s" ] || continue
        [ -d "$REPO/system/$s/root" ] || out="${out:+$out }$s"
    done < <(sys_scopes "$p")
    printf '%s\n' "$out"
}

# Every file of every active scope. Two scopes may legitimately ship the same
# target (a distribution overriding a common file): the last one wins, which is
# why the order of sys_scopes is part of the contract. sys_conflicts reports it.
sys_files() {
    local scope
    while read -r scope; do
        find "$REPO/system/$scope/root" -type f 2>/dev/null
    done < <(sys_scopes "${1:-$DEFAULT_PROFILE}")
}

# Path in the repository -> path on the system. The scope is a variable path
# component, so it is stripped with a glob rather than a fixed prefix.
sys_target() {
    local rel="${1#"$REPO"/system/}"
    printf '%s\n' "${rel#*/root}"
}

sys_mode()   { case "$1" in */bin/*|*/sbin/*) echo 755 ;; *) echo 644 ;; esac; }

# Targets shipped by more than one active scope. Silence here would mean a file
# deployed from a scope the reader did not expect.
sys_conflicts() {
    local f
    while read -r f; do
        printf '%s\t%s\n' "$(sys_target "$f")" "${f#"$REPO"/system/}"
    done < <(sys_files "${1:-$DEFAULT_PROFILE}") \
        | sort | awk -F'\t' '{ if ($1 == prev) print; prev = $1 }'
}

cmd_system_apply() {
    local profile="${1:-$DEFAULT_PROFILE}"
    profile_check "$profile"
    head_ "system-apply ($profile, sudo)"
    command -v sudo >/dev/null || die "sudo required"
    info "  ${D}scopes: $(sys_scopes "$profile" | tr '\n' ' ')${N}"
    local f target
    while read -r f; do
        target="$(sys_target "$f")"
        sudo install -Dm"$(sys_mode "$target")" "$f" "$target" && ok "$target"
    done < <(sys_files "$profile")
    info ""
    info "  ${D}Reloading is recommended: sudo udevadm control --reload && sudo systemctl daemon-reload${N}"
}

cmd_system_pull() {
    local profile="${1:-$DEFAULT_PROFILE}"
    profile_check "$profile"
    head_ "system-pull ($profile)"
    local f target n=0
    while read -r f; do
        target="$(sys_target "$f")"
        if [ -r "$target" ] && ! cmp -s "$f" "$target"; then
            cp "$target" "$f"; chmod u+w "$f"; ok "$target"; n=$((n+1))
        fi
    done < <(sys_files "$profile")
    [ "$n" -eq 0 ] && ok "nothing to pull back"
    return 0
}

# === packages ================================================================
# packages/<distro>/<group>.txt. The profile names groups and never a
# distribution: `packages: core shell fonts` is meant to hold on Arch as well as
# on Ubuntu, only the directory it is read from changes.
PKGDIR() { printf '%s\n' "$REPO/packages/$(distro)"; }

# The packages a profile asks for, one per line, comments stripped.
pkg_wanted() {
    local profile="$1" groups g
    groups=$(profile_setting "$profile" packages)
    [ -n "$groups" ] || die "profile $profile declares no package group"
    for g in $groups; do cat "$(PKGDIR)/$g.txt" 2>/dev/null; done \
        | grep -vE '^\s*(#|$)' | sort -u
}

# Manually installed packages, as this distribution reports them. Empty when the
# distribution is unknown, which every caller treats as "cannot tell".
pkg_installed() {
    case "$(distro)" in
        arch)   command -v pacman >/dev/null || return 0
                pacman -Qqen 2>/dev/null | sort -u; pacman -Qqem 2>/dev/null | sort -u ;;
        ubuntu|debian)
                command -v apt-mark >/dev/null || return 0
                apt-mark showmanual 2>/dev/null | sort -u ;;
    esac
}

cmd_install() {
    local profile="${1:-$DEFAULT_PROFILE}"
    profile_check "$profile"
    head_ "install ($profile, $(distro))"
    [ -d "$(PKGDIR)" ] || die "no package list for $(distro): $(PKGDIR) does not exist"
    local native aur helper
    native=$(pkg_wanted "$profile")
    [ -n "$native" ] || die "no package to install: $(PKGDIR) is empty for these groups"
    info "  Official packages: $(printf '%s\n' "$native" | wc -l)"
    case "$(distro)" in
        arch)
            sudo pacman -S --needed --noconfirm $native || warn "some packages failed"
            # The AUR has no equivalent elsewhere: the setting is simply ignored.
            if grep -qE '^\s*aur:\s*yes' "$PROFILES/$profile.conf"; then
                helper=$(command -v paru || command -v yay) \
                    || { warn "neither paru nor yay, AUR skipped (see packages/arch/manual.md)"; return 0; }
                aur=$(grep -vE '^\s*(#|$)' "$(PKGDIR)/aur.txt" | sort -u)
                info "  AUR packages: $(printf '%s\n' "$aur" | wc -l)"
                "$helper" -S --needed --noconfirm $aur || warn "some AUR packages failed"
            fi ;;
        ubuntu|debian)
            sudo apt-get install -y $native || warn "some packages failed" ;;
        *)  die "unsupported distribution: $(distro) (add packages/$(distro)/ and a case here)" ;;
    esac
}

# === suckless ================================================================
cmd_build_suckless() {
    head_ "build-suckless (sudo)"
    local p rc=0
    for p in dwm st dmenu slock dwmblocks; do
        [ -d "$REPO/suckless/$p" ] || continue
        info "  ${B}$p${N}"
        if (cd "$REPO/suckless/$p" && make clean >/dev/null 2>&1; sudo make install >/dev/null 2>&1); then
            ok "$p installed"
        else
            err "$p: build failed, run it by hand: cd suckless/$p && make"
            rc=1
        fi
    done
    [ -e /usr/local/bin/slock ] && sudo chmod u+s /usr/local/bin/slock && ok "setuid bit set on slock"
    return $rc
}

# === sync ====================================================================
cmd_sync() {
    head_ "sync"
    "$0" system-pull
    # Only Arch has a list that regenerates itself: aur.txt is exactly the set of
    # foreign packages. apt has no such notion, so nothing to sync there.
    if [ "$(distro)" = arch ] && command -v pacman >/dev/null; then
        local aurlist="$(PKGDIR)/aur.txt"
        pacman -Qqem | sort > "$aurlist.new"
        if ! cmp -s "$aurlist.new" "$aurlist"; then
            mv "$aurlist.new" "$aurlist"; ok "packages/arch/aur.txt updated"
        else rm -f "$aurlist.new"; fi
    fi
    "$0" state
    head_ "git"
    git -C "$REPO" add -A
    git -C "$REPO" status --short | head -30
    info ""
    info "  ${D}Ready to commit: git commit -m \"...\"${N}"
}

# === system snapshot =========================================================
cmd_state() {
    local out="$REPO/system/state.md"
    {
        echo "# System state"
        echo
        echo "Generated by \`dot state\` on $(date '+%Y-%m-%d %H:%M') on \`$(hostnamectl hostname 2>/dev/null || cat /etc/hostname)\`."
        echo "A **reference** document for reinstalling. Nothing here is replayed automatically."
        echo
        echo '## systemd services (system)'
        echo '```'; systemctl list-unit-files --state=enabled --no-pager 2>/dev/null | head -40; echo '```'
        echo
        echo '## systemd services (user)'
        echo '```'; systemctl --user list-unit-files --state=enabled --no-pager 2>/dev/null; echo '```'
        echo
        echo '## User'
        echo '```'
        echo "groups : $(id -nG)"
        echo "shell  : $SHELL"
        echo '```'
        echo
        echo '## Locale, time, machine'
        echo '```'
        localectl status 2>/dev/null
        echo "timezone : $(timedatectl show -p Timezone --value 2>/dev/null)"
        echo '```'
        echo
        echo '## Bootloader and kernel'
        echo '```'
        echo "kernel : $(uname -r)"
        [ -d /boot/grub ] && echo "bootloader : grub"
        [ -d /boot/loader ] && echo "bootloader : systemd-boot"
        echo '```'
    } > "$out"
    ok "system/state.md regenerated"
}

