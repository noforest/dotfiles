# === bootstrap ===============================================================
# The default chain assumes a suckless environment: build-suckless compiles dwm,
# st, dmenu, slock and dwmblocks, which is pointless on a profile that runs none
# of them. A profile overrides the chain with a `steps:` line rather than this
# script testing for a module by name.
BOOTSTRAP_STEPS="install link system-apply fonts build-suckless nvim-patch"

cmd_bootstrap() {
    local profile="${1:-$DEFAULT_PROFILE}"
    profile_check "$profile"
    head_ "bootstrap ($profile)"

    # De toutes les commandes, c'est la plus lourde : elle installe des paquets,
    # écrit dans /etc en root et remplace des fichiers de $HOME. Quand personne
    # n'a nommé le profil, il vient du châssis ou d'un repli, et une tour prise
    # pour un portable recevrait le touchpad, le rétroéclairage et la gestion du
    # capot. D'où le récapitulatif, et la confirmation quand rien n'a été choisi.
    if [ $# -eq 0 ]; then
        info "  ${D}host $(hostname), chassis $(hostnamectl chassis 2>/dev/null || echo unknown), distro $(distro)${N}"
        if [ "$DEFAULT_PROFILE_SOURCE" = fallback ]; then
            warn "profile '$profile' chosen by nobody: no machine.d/$(hostname).conf and no usable chassis"
        else
            info "  ${D}profile '$profile', from $DEFAULT_PROFILE_SOURCE${N}"
        fi
        info "  ${D}scopes: $(sys_scopes "$profile" | tr '\n' ' ')${N}"
        printf '  Continue? [y/N] '
        read -r answer
        case "$answer" in
            [yY]*) ;;
            *) die "aborted. Name it explicitly: dot bootstrap <profile>" ;;
        esac
    fi

    local steps step
    steps=$(profile_setting "$profile" steps)
    [ -n "$steps" ] || steps="$BOOTSTRAP_STEPS"
    info "  ${D}steps: $steps${N}"
    for step in $steps; do
        case "$step" in
            # Only these take a profile; passing one to the others would be read
            # as their own argument (nvim-patch --save, audit <what>).
            install|link|system-apply|system-pull) "$0" "$step" "$profile" ;;
            *) "$0" "$step" ;;
        esac
    done
    info ""
    ok "bootstrap finished"
    info "  ${D}Remaining manual steps: see the \"After the bootstrap\" section of the README.${N}"
}

# === help ====================================================================
# The manual is the reference, but two of its sections answer the questions
# actually asked while working: what a command does, and what a status line
# means. Reaching them should not require knowing how to search a man page, nor
# the manual being installed: the page is read from the repository.
MANPAGE="$MODULES/shell/.local/share/man/man1/dot.1"

# A section of the manual is a manual page, so it is read with whatever reads
# them here: $MANPAGER, which .zshrc sets to vimpager. vim brings the syntax
# highlighting man pages deserve, the C of a SYNOPSIS in particular, and visual
# mode to select across the whole page rather than across one screen. Anything
# else falls back to less, then to plain text.
pager_ok() { [ -n "$TTY" ]; }
pager_() {
    local p="${MANPAGER:-${PAGER:-}}"
    pager_ok || { cat; return; }
    command -v "${p%% *}" >/dev/null 2>&1 || p=""
    if   [ -n "$p" ]; then sh -c "$p"
    elif command -v less >/dev/null; then less -R
    else cat
    fi
}

# The manual rendered to plain text, formatting kept when a pager is there to
# make sense of it. Kept exactly as man would hand it to that pager, so a
# section reads like the page it comes from.
man_render() {
    local width="${MANWIDTH:-}"
    if [ -z "$width" ]; then
        width=$(tput cols 2>/dev/null || echo 80)
        # Text stops being readable long before a terminal stops being wide, and
        # the tables of the page stretch with it. $MANWIDTH still has the last word.
        [ "$width" -gt 100 ] 2>/dev/null && width=100
    fi
    if pager_ok; then
        MANWIDTH="$width" MAN_KEEP_FORMATTING=1 man -l "$MANPAGE" 2>/dev/null
    else
        MANWIDTH="$width" man -l "$MANPAGE" 2>/dev/null
    fi
}

# One section of the rendered manual, from its heading to the next one.
# Headings are the only lines starting at column zero, which is what delimits
# them here. Every line is compared stripped of its formatting, printed with it.
man_section() {  # man_section <heading, as printed>
    command -v man >/dev/null || die "man is not installed, read $MANPAGE"
    [ -r "$MANPAGE" ] || die "manual not found: $MANPAGE"
    man_render | awk -v h="$1" '
        { plain = $0; gsub(/\033\[[0-9;]*m/, "", plain); gsub(/.\b/, "", plain) }
        plain == h                           { on = 1 }
        on && plain != h && plain ~ /^[A-Z]/ { exit }
        on                                   { print }
    '
}

cmd_help() {
    local section
    case "${1:-}" in
        "")               usage; return ;;
        commands|command) section="COMMANDS" ;;
        status|st)        section="READING DOT STATUS" ;;
        examples|ex)      section="EXAMPLES" ;;
        *) die "usage: dot help [commands|status|examples]" ;;
    esac
    man_section "$section" | pager_
}

usage() {
    cat <<EOF
${B}dot${N} - dotfiles management for dwm / Arch

  ${G}dot link${N} [profile]       Create the symlinks (existing files are backed up)
  ${G}dot unlink${N} [profile]     Remove the links it created
  ${G}dot list${N} [profile]       List the paths the profile manages
  ${G}dot adopt${N} <path> [mod]   Move a file or a directory from \$HOME into a module
                           Without <mod>, pick one from a table of the profiles
                           each module reaches.
  ${G}dot status${N} [profile]     Drift of links, system/, packages and secrets
  ${G}dot sync${N}                 Regenerate lists and system state, then git add -A

  ${G}dot install${N} [profile]    Install the packages of the profile
  ${G}dot system-apply${N} [profile] Copy the profile scopes of system/ to / (sudo)
  ${G}dot system-pull${N} [profile]  Pull /etc and /usr/local/bin back into the repo
  ${G}dot nvim-patch${N}           Apply the snacks patch that config cannot express
  ${G}dot build-suckless${N}       Build and install dwm, st, dmenu, slock, dwmblocks
  ${G}dot fonts${N}                Install the fonts that are not packaged
  ${G}dot audit${N} [what]         What this machine really uses: packages, scripts, or all
  ${G}dot state${N}                Regenerate system/state.md
  ${G}dot bootstrap${N} [profile]  Chain everything: bare machine to full environment

  ${R}dot help commands${N}        ${R}The manual on every command: what it does, when
                           to use it, what it refuses to do${N}
  ${R}dot help status${N}          ${R}The manual on every line 'dot status' prints:
                           what each verdict means, and what repairs it${N}
  ${R}dot help examples${N}        ${R}What to run, situation by situation${N}

${D}All three are sections of '${N}${G}man dot${N}${D}', the full reference.
'${N}${G}dotgit${N}${D}' is an alias for git -C "$REPO".${N}

Profiles: $(ls "$PROFILES" 2>/dev/null | sed 's/\.conf//' | tr '\n' ' ')(default: $DEFAULT_PROFILE, from $DEFAULT_PROFILE_SOURCE)
Modules : $(ls "$MODULES" 2>/dev/null | tr '\n' ' ')
Machine : $(hostname), $(distro), chassis $(hostnamectl chassis 2>/dev/null || echo unknown)
Scopes  : $(ls -d "$REPO"/system/*/root 2>/dev/null | sed 's|.*/system/||;s|/root||' | tr '\n' ' ')
EOF
}

# === dispatch ================================================================
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
    link)           cmd_link "$@" ;;
    unlink)         cmd_unlink "$@" ;;
    list)           cmd_list "$@" ;;
    adopt)          cmd_adopt "$@" ;;
    status)         cmd_status "$@" ;;
    st)             cmd_status "$@" ;;
    sync)           cmd_sync "$@" ;;
    install)        cmd_install "$@" ;;
    system-apply)   cmd_system_apply "$@" ;;
    system-pull)    cmd_system_pull "$@" ;;
    build-suckless) cmd_build_suckless "$@" ;;
    fonts)          cmd_fonts "$@" ;;
    nvim-patch)     cmd_nvim_patch "$@" ;;
    audit)          cmd_audit "$@" ;;
    state)          cmd_state "$@" ;;
    bootstrap)      cmd_bootstrap "$@" ;;
    help|-h|--help) cmd_help "$@" ;;
    *)              err "unknown command: $cmd"; usage; exit 1 ;;
esac
