#!/usr/bin/env bash
# dot - dotfiles management (dwm / Arch Linux)
# See README.md for the full procedure.
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
MODULES="$REPO/modules"
PROFILES="$REPO/profiles"
DEFAULT_PROFILE=laptop

# === Output ==================================================================
if [ -t 1 ]; then
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; D=$'\e[2m'; N=$'\e[0m'
else
    R=; G=; Y=; B=; D=; N=
fi
info() { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
err()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; }
head_() { printf '\n%s== %s %s%s\n' "$B" "$*" "$(printf '=%.0s' $(seq 1 $((60 - ${#1})))) " "$N"; }
die()  { err "$*"; exit 1; }

# === Profiles and modules ====================================================
# profile_modules runs inside a process substitution, where die() only exits the
# subshell. Commands therefore validate the profile up front, so an unknown name
# exits non zero instead of reporting an error and returning success.
profile_check() {
    local p="${1:-$DEFAULT_PROFILE}"
    [ -f "$PROFILES/$p.conf" ] || die "unknown profile: $p (available: $(ls "$PROFILES" | sed 's/\.conf//' | tr '\n' ' '))"
}

profile_modules() {
    local p="${1:-$DEFAULT_PROFILE}" f="$PROFILES/${1:-$DEFAULT_PROFILE}.conf"
    [ -f "$f" ] || die "unknown profile: $p (available: $(ls "$PROFILES" | sed 's/\.conf//' | tr '\n' ' '))"
    # Lines shaped `key: value` are settings. Everything else is a module name.
    grep -vE '^\s*(#|$)' "$f" | grep -v ':' | tr -d ' \t'
}

is_submodule() {  # is_submodule <absolute-path>
    [ -f "$REPO/.gitmodules" ] || return 1
    local rel="${1#"$REPO"/}"
    git -C "$REPO" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
        | awk '{print $2}' | grep -qx "$rel"
}

# Lists the "link units" of a module as paths relative to $HOME.
# A submodule is linked as a whole directory. Everything else is linked file by file.
module_units() {
    local mod="$1" root="$MODULES/$1"
    [ -d "$root" ] || return 0
    _walk() {
        local dir="$1"
        local e
        for e in "$dir"/* "$dir"/.[!.]*; do
            [ -e "$e" ] || continue
            if [ -d "$e" ] && ! [ -L "$e" ]; then
                if is_submodule "$e"; then printf '%s\n' "${e#"$root"/}"; else _walk "$e"; fi
            else
                printf '%s\n' "${e#"$root"/}"
            fi
        done
    }
    _walk "$root"
}

# Runtime state owned by a daemon, which must NEVER become a symlink.
# xfconfd rewrites its XML atomically and watches it through inotify. Linking
# those files into the repo made it loop, which saturated the session D-Bus and
# froze thunar and flameshot. This is state, not configuration.
NEVER_LINK='/\.config/systemd/|/\.config/xfce4/xfconf/|/\.config/dconf/|/\.config/pulse/|/\.local/state/|\.lock$|/savedState\.|/recently-used'

cmd_check_never_link() {  # cmd_check_never_link <relative-path> -> 0 if forbidden
    printf '%s\n' "/$1" | grep -qE "$NEVER_LINK"
}

# === link / unlink ===========================================================
cmd_link() {
    local profile="${1:-$DEFAULT_PROFILE}" stamp created=0 backed=0 already=0
    profile_check "$profile"
    stamp=$(date +%Y%m%d-%H%M%S)
    head_ "link ($profile)"
    local mod rel src dst
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            if cmd_check_never_link "$rel"; then
                err "REFUSED (daemon state, not configuration): $rel"
                continue
            fi
            src="$MODULES/$mod/$rel"; dst="$HOME/$rel"
            if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then
                already=$((already+1)); continue
            fi
            mkdir -p "$(dirname "$dst")"
            if [ -e "$dst" ] || [ -L "$dst" ]; then
                mv "$dst" "$dst.bak-$stamp" || { err "could not back up: $rel"; continue; }
                warn "$rel ${D}-> backed up as $(basename "$dst").bak-$stamp${N}"
                backed=$((backed+1))
            fi
            ln -s "$src" "$dst" && created=$((created+1))
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    info ""
    ok "$created link(s) created, $already already in place, $backed backup(s)"
    [ "$backed" -gt 0 ] && info "  ${D}Backups carry the .bak-$stamp suffix. Delete them once you have checked.${N}"
    return 0
}

cmd_unlink() {
    local profile="${1:-$DEFAULT_PROFILE}" n=0 mod rel dst
    profile_check "$profile"
    head_ "unlink ($profile)"
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            dst="$HOME/$rel"
            if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$MODULES/$mod/$rel")" ]; then
                rm "$dst" && n=$((n+1))
            fi
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    ok "$n link(s) removed, the .bak-* files are kept"
}

cmd_list() {
    local profile="${1:-$DEFAULT_PROFILE}" mod
    profile_check "$profile"
    while read -r mod; do module_units "$mod"; done < <(profile_modules "$profile")
}

# === adopt: the everyday command =============================================
# A file lives in exactly one module, and the module decides which profiles carry
# it. The picker therefore shows, for every module, the profiles it reaches.
modules_all() { find "$MODULES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; }

# Profiles from the narrowest to the widest, so the table reads as growing scope.
profiles_by_scope() {
    local f p
    for f in "$PROFILES"/*.conf; do
        [ -e "$f" ] || continue
        p="$(basename "$f" .conf)"
        printf '%s\t%s\n' "$(profile_modules "$p" | wc -l)" "$p"
    done | sort -n | cut -f2
}

module_profiles() {  # module_profiles <module> -> the profiles carrying it
    local mod="$1" p out=""
    while read -r p; do
        profile_modules "$p" | grep -qx "$mod" && out="$out$p "
    done < <(profiles_by_scope)
    printf '%s' "${out% }"
}

# The chosen module goes to stdout, the table to stderr: the caller captures it.
pick_module() {  # pick_module <path> -> module name
    local path="$1" m w=4 i=1 choice p row
    local mods=()
    while read -r m; do
        mods+=("$m")
        [ "${#m}" -gt "$w" ] && w="${#m}"
    done < <(modules_all)
    [ "${#mods[@]}" -gt 0 ] || die "no module in $MODULES"

    printf '\n  Which module should carry %s%s%s?\n\n' "$B" "$path" "$N" >&2
    printf '      %s%-*s  %s%s\n' "$D" "$w" "MODULE" "PROFILES" "$N" >&2
    for m in "${mods[@]}"; do
        row=""
        for p in $(module_profiles "$m"); do
            # The default profile is this machine's, so it deserves to stand out.
            if [ "$p" = "$DEFAULT_PROFILE" ]; then row="$row$B$p$N "; else row="$row$D$p$N "; fi
        done
        printf '  %s%2d)%s %s%-*s%s  %s\n' "$Y" "$i" "$N" "$G" "$w" "$m" "$N" "${row% }" >&2
        i=$((i+1))
    done
    printf '\n  %s%s is this machine default profile.%s\n' "$D" "$B$DEFAULT_PROFILE$N$D" "$N" >&2
    printf '  %sModule [1-%d], q to cancel:%s ' "$D" "${#mods[@]}" "$N" >&2

    read -r choice || { err "no module given: dot adopt <path> [module]"; return 1; }
    case "$choice" in
        q|Q|"")   err "cancelled"; return 1 ;;
        *[!0-9]*) err "not a number: $choice"; return 1 ;;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le "${#mods[@]}" ] || { err "out of range: $choice"; return 1; }
    printf '%s\n' "${mods[$((choice-1))]}"
}

# Moves one file into the module and links it back. Returns 1 on a skip instead
# of exiting, so adopting a directory can carry on past a file it must leave alone.
adopt_one() {  # adopt_one <absolute-file> <module>
    local abs="$1" mod="$2"
    # Two separate `local`s: bash expands every argument of a `local` before assigning
    # any of them, so "$rel" would be read before it exists (and `set -u` would abort).
    local rel="${abs#"$HOME"/}"
    local dst="$MODULES/$mod/$rel"
    if cmd_check_never_link "$rel"; then
        warn "skipped, runtime state owned by a daemon: $rel"; return 1
    fi
    [ -e "$dst" ] && { err "already present in module $mod: $rel"; return 1; }
    mkdir -p "$(dirname "$dst")"
    mv "$abs" "$dst" || { err "move failed: $rel"; return 1; }
    ln -s "$dst" "$abs"
    ok "$rel"
}

# A directory is adopted file by file, never as a whole: module_units lists a
# module back file by file, so a directory-wide symlink would make the next
# `dot link` rename the module own files to .bak-* and leave circular symlinks.
# The directory itself stays a real directory in $HOME, holding the symlinks.
adopt_dir() {  # adopt_dir <absolute-dir> <module>
    local abs="$1" mod="$2" f n=0 skipped=0
    while read -r f; do
        warn "skipped, git repository: ${f%/.git}"
        skipped=$((skipped+1))
    done < <(find "$abs" -name .git -print)
    while read -r f; do
        if [ -L "$f" ]; then
            warn "skipped, already a symlink: ${f#"$HOME"/}"; skipped=$((skipped+1)); continue
        fi
        if adopt_one "$f" "$mod"; then n=$((n+1)); else skipped=$((skipped+1)); fi
    done < <(find "$abs" -name .git -prune -o \( -type f -o -type l \) -print | sort)
    info ""
    ok "$n file(s) adopted, $skipped skipped"
    [ "$n" -gt 0 ]
}

cmd_adopt() {
    local path="${1:-}" mod="${2:-}"
    [ -n "$path" ] || die "usage: dot adopt <path> [module]"
    local abs; abs="$(readlink -f "$path")" || die "path not found: $path"
    [ -e "$abs" ] || die "path not found: $path"
    case "$abs" in "$HOME"/*) ;; *) die "outside of \$HOME: $abs" ;; esac
    [ -L "$path" ] && die "already a symlink: $path"
    [ -n "$mod" ] || { mod="$(pick_module "~/${abs#"$HOME"/}")" || exit 1; }
    [ -d "$MODULES/$mod" ] || die "unknown module: $mod (available: $(modules_all | tr '\n' ' '))"

    head_ "adopt into $mod"
    local rc=0
    if [ -d "$abs" ]; then adopt_dir "$abs" "$mod" || rc=1
    else adopt_one "$abs" "$mod" || rc=1; fi
    if [ "$rc" -eq 0 ]; then
        info "  ${D}-> carried by profiles: $(module_profiles "$mod")${N}"
        info "  ${D}-> remember to commit${N}"
    fi
    return $rc
}

# === status ==================================================================
SECRET_PATTERNS='(^|/)(\.ssh|\.gnupg|\.certs)/|rclone\.conf$|(^|/)\.npmrc$|(^|/)\.netrc$|atuin/config\.toml$|gh/hosts\.yml$|solaar/config\.yaml$|vlcrc$|\.pem$|\.key$|id_rsa|id_ed25519'

cmd_status() {
    local profile="${1:-$DEFAULT_PROFILE}" rc=0
    profile_check "$profile"

    head_ "links ($profile)"
    local mod rel dst missing=0 broken=0 foreign=0 linked=0
    while read -r mod; do
        while read -r rel; do
            [ -n "$rel" ] || continue
            dst="$HOME/$rel"
            if [ -L "$dst" ]; then
                if [ ! -e "$dst" ]; then err "broken link: $rel"; broken=$((broken+1)); rc=1
                elif [ "$(readlink -f "$dst")" = "$(readlink -f "$MODULES/$mod/$rel")" ]; then linked=$((linked+1))
                else warn "link points elsewhere: $rel -> $(readlink "$dst")"; foreign=$((foreign+1)); fi
            elif [ -e "$dst" ]; then
                warn "real file, not linked: $rel"; foreign=$((foreign+1))
            else
                warn "missing from \$HOME: $rel"; missing=$((missing+1))
            fi
        done < <(module_units "$mod")
    done < <(profile_modules "$profile")
    ok "$linked linked, $missing missing, $foreign not linked, $broken broken"

    head_ "system/ vs the root filesystem"
    local f target diverged=0 absent=0 same=0
    while read -r f; do
        target="$(sys_target "$f")"
        if [ ! -e "$target" ]; then warn "missing from the system: $target"; absent=$((absent+1))
        elif ! cmp -s "$f" "$target"; then err "diverges: $target"; diverged=$((diverged+1)); rc=1
        else same=$((same+1)); fi
    done < <(sys_files)
    ok "$same identical, $diverged diverging, $absent missing from the system"
    [ "$diverged" -gt 0 ] && info "  ${D}-> 'dot system-pull' to pull them back, 'dot system-apply' to overwrite${N}"

    head_ "packages"
    if command -v pacman >/dev/null; then
        local catalogued installed uncat
        catalogued=$(cat "$REPO"/packages/*.txt 2>/dev/null | grep -vE '^\s*(#|$)' | sort -u)
        installed=$(pacman -Qqen 2>/dev/null | sort -u; pacman -Qqem 2>/dev/null | sort -u)
        uncat=$(comm -13 <(printf '%s\n' "$catalogued") <(printf '%s\n' "$installed" | sort -u))
        if [ -n "$uncat" ]; then
            warn "$(printf '%s\n' "$uncat" | wc -l) package(s) installed but missing from the lists:"
            printf '%s\n' "$uncat" | head -15 | sed "s/^/      ${D}/;s/\$/${N}/"
            [ "$(printf '%s\n' "$uncat" | wc -l)" -gt 15 ] && info "      ${D}...${N}"
            info "  ${D}-> 'dot sync' updates the lists${N}"
        else ok "every list is up to date"; fi
    fi

    head_ "secrets"
    local leaked
    leaked=$(git -C "$REPO" ls-files 2>/dev/null | grep -E "$SECRET_PATTERNS")
    if [ -n "$leaked" ]; then
        err "SENSITIVE FILES TRACKED BY GIT:"
        printf '%s\n' "$leaked" | sed 's/^/      /'
        info "  ${D}-> git rm --cached <file>, then check .gitignore${N}"
        rc=1
    else ok "no sensitive file is tracked"; fi

    return $rc
}

# === system ==================================================================
# system/root/ mirrors the real tree: system/root/etc/x maps to /etc/x
sys_files()  { find "$REPO/system/root" -type f 2>/dev/null; }
sys_target() { printf '%s\n' "${1#"$REPO"/system/root}"; }
sys_mode()   { case "$1" in */bin/*|*/sbin/*) echo 755 ;; *) echo 644 ;; esac; }

cmd_system_apply() {
    head_ "system-apply (sudo)"
    command -v sudo >/dev/null || die "sudo required"
    local f target
    while read -r f; do
        target="$(sys_target "$f")"
        sudo install -Dm"$(sys_mode "$target")" "$f" "$target" && ok "$target"
    done < <(sys_files)
    info ""
    info "  ${D}Reloading is recommended: sudo udevadm control --reload && sudo systemctl daemon-reload${N}"
}

cmd_system_pull() {
    head_ "system-pull"
    local f target n=0
    while read -r f; do
        target="$(sys_target "$f")"
        if [ -r "$target" ] && ! cmp -s "$f" "$target"; then
            cp "$target" "$f"; chmod u+w "$f"; ok "$target"; n=$((n+1))
        fi
    done < <(sys_files)
    [ "$n" -eq 0 ] && ok "nothing to pull back"
    return 0
}

# === packages ================================================================
cmd_install() {
    local profile="${1:-$DEFAULT_PROFILE}"
    profile_check "$profile"
    head_ "install ($profile)"
    command -v pacman >/dev/null || die "pacman not found, Arch only"
    local groups native aur helper
    groups=$(grep -E '^\s*packages:' "$PROFILES/$profile.conf" | sed 's/.*packages:\s*//')
    [ -n "$groups" ] || die "profile $profile declares no package group"
    native=$(for g in $groups; do cat "$REPO/packages/$g.txt" 2>/dev/null; done | grep -vE '^\s*(#|$)' | sort -u)
    [ -n "$native" ] && { info "  Official packages: $(printf '%s\n' "$native" | wc -l)"; sudo pacman -S --needed --noconfirm $native || warn "some packages failed"; }
    if grep -qE '^\s*aur:\s*yes' "$PROFILES/$profile.conf"; then
        helper=$(command -v paru || command -v yay) || { warn "neither paru nor yay, AUR skipped (see packages/manual.md)"; return 0; }
        aur=$(grep -vE '^\s*(#|$)' "$REPO/packages/aur.txt" | sort -u)
        info "  AUR packages: $(printf '%s\n' "$aur" | wc -l)"
        "$helper" -S --needed --noconfirm $aur || warn "some AUR packages failed"
    fi
}

# === suckless ================================================================
cmd_build_suckless() {
    head_ "build-suckless (sudo)"
    local p rc=0
    for p in dwm st dmenu slock dwmblocks; do
        [ -d "$REPO/suckless/$p" ] || continue
        info "  ${B}$p${N}"
        if (cd "$REPO/suckless/$p" && make clean >/dev/null 2>&1; sudo make install >/dev/null 2>&1); then
            ok "$p installed"
        else
            err "$p: build failed, run it by hand: cd suckless/$p && make"
            rc=1
        fi
    done
    [ -e /usr/local/bin/slock ] && sudo chmod u+s /usr/local/bin/slock && ok "setuid bit set on slock"
    return $rc
}

# === sync ====================================================================
cmd_sync() {
    head_ "sync"
    "$0" system-pull
    if command -v pacman >/dev/null; then
        pacman -Qqem | sort > "$REPO/packages/aur.txt.new"
        if ! cmp -s "$REPO/packages/aur.txt.new" "$REPO/packages/aur.txt"; then
            mv "$REPO/packages/aur.txt.new" "$REPO/packages/aur.txt"; ok "packages/aur.txt updated"
        else rm -f "$REPO/packages/aur.txt.new"; fi
    fi
    "$0" state
    head_ "git"
    git -C "$REPO" add -A
    git -C "$REPO" status --short | head -30
    info ""
    info "  ${D}Ready to commit: git commit -m \"...\"${N}"
}

# === system snapshot =========================================================
cmd_state() {
    local out="$REPO/system/state.md"
    {
        echo "# System state"
        echo
        echo "Generated by \`dot state\` on $(date '+%Y-%m-%d %H:%M') on \`$(hostnamectl hostname 2>/dev/null || cat /etc/hostname)\`."
        echo "A **reference** document for reinstalling. Nothing here is replayed automatically."
        echo
        echo '## systemd services (system)'
        echo '```'; systemctl list-unit-files --state=enabled --no-pager 2>/dev/null | head -40; echo '```'
        echo
        echo '## systemd services (user)'
        echo '```'; systemctl --user list-unit-files --state=enabled --no-pager 2>/dev/null; echo '```'
        echo
        echo '## User'
        echo '```'
        echo "groups : $(id -nG)"
        echo "shell  : $SHELL"
        echo '```'
        echo
        echo '## Locale, time, machine'
        echo '```'
        localectl status 2>/dev/null
        echo "timezone : $(timedatectl show -p Timezone --value 2>/dev/null)"
        echo '```'
        echo
        echo '## Bootloader and kernel'
        echo '```'
        echo "kernel : $(uname -r)"
        [ -d /boot/grub ] && echo "bootloader : grub"
        [ -d /boot/loader ] && echo "bootloader : systemd-boot"
        echo '```'
    } > "$out"
    ok "system/state.md regenerated"
}

# === fonts ===================================================================
cmd_fonts() {
    head_ "fonts"
    bash "$REPO/scripts/fonts-manual.sh"
}

# === nvim ====================================================================
# One single change cannot be expressed as configuration. The patch header
# explains which one. Everything else lives in lazy.lua.
cmd_nvim_patch() {
    local mode="${1:-apply}" dir="$MODULES/nvim/.config/nvim/patches" lazy="$HOME/.local/share/nvim/lazy"
    head_ "nvim-patch ($mode)"
    [ -d "$dir" ] || { warn "no patch"; return 0; }
    local p name plug rc=0
    for p in "$dir"/*.patch; do
        [ -e "$p" ] || { warn "no patch"; return 0; }
        name=$(basename "$p" .patch); plug="$lazy/$name"
        [ -d "$plug/.git" ] || { warn "$name: plugin not installed (run nvim, then :Lazy sync)"; continue; }
        if [ "$mode" = "--save" ]; then
            warn "$name: regeneration is disabled, this patch is written by hand and carries an explanation in its header"
        elif git -C "$plug" apply --check --reverse "$p" 2>/dev/null; then
            ok "$name already applied"
        elif git -C "$plug" apply --3way "$p" 2>/dev/null; then
            ok "$name applied"
        else
            err "$name: the patch no longer applies, upstream moved, redo it by hand"
            rc=1
        fi
    done
    return $rc
}

# === usage audit =============================================================
cmd_audit() {
    bash "$REPO/scripts/audit-usage.sh" "${1:-all}"
}

# === bootstrap ===============================================================
cmd_bootstrap() {
    local profile="${1:-$DEFAULT_PROFILE}"
    head_ "bootstrap ($profile)"
    "$0" install "$profile"
    "$0" link "$profile"
    "$0" system-apply
    "$0" fonts
    "$0" build-suckless
    "$0" nvim-patch
    info ""
    ok "bootstrap finished"
    info "  ${D}Remaining manual steps: see the \"After the bootstrap\" section of the README.${N}"
}

# === help ====================================================================
usage() {
    cat <<EOF
${B}dot${N} - dotfiles management for dwm / Arch

  ${G}dot link${N} [profile]       Create the symlinks (existing files are backed up)
  ${G}dot unlink${N} [profile]     Remove the links it created
  ${G}dot list${N} [profile]       List the paths the profile manages
  ${G}dot adopt${N} <path> [mod]   Move a file or a directory from \$HOME into a module
                           Without <mod>, pick one from a table of the profiles
                           each module reaches.
  ${G}dot status${N} [profile]     Drift of links, system/, packages and secrets
  ${G}dot sync${N}                 Regenerate lists and system state, then git add -A

  ${G}dot install${N} [profile]    Install the packages of the profile
  ${G}dot system-apply${N}         Copy system/ to /etc and /usr/local/bin (sudo)
  ${G}dot system-pull${N}          Pull /etc and /usr/local/bin back into the repo
  ${G}dot nvim-patch${N}           Apply the snacks patch that config cannot express
  ${G}dot build-suckless${N}       Build and install dwm, st, dmenu, slock, dwmblocks
  ${G}dot fonts${N}                Install the fonts that are not packaged
  ${G}dot audit${N} [what]         What this machine really uses: packages, scripts, or all
  ${G}dot state${N}                Regenerate system/state.md
  ${G}dot bootstrap${N} [profile]  Chain everything: bare machine to full environment

${B}When to use what${N}

  ${G}adopt${N} then ${G}sync${N}   The everyday pair. adopt moves a file from \$HOME into a
                    module and links it back, so there is nothing to run after
                    it. sync then picks up what lives outside \$HOME (/etc into
                    system/root/, the AUR list, system/state.md) and runs
                    git add -A. It stops there: commit yourself.
  ${G}bootstrap${N}         A new machine, once. Chains install, link, system-apply,
                    fonts, build-suckless and nvim-patch, so those five are
                    rarely called by hand.
  ${G}link${N}              When files reach the repo without passing through you:
                    after a git pull, or after adding a module to a profile.
                    Also repairs what status reports as missing or broken.
                    Never needed right after an adopt.
  ${G}status${N}            Any doubt. Read only, and safe to run at any time.

Profiles: $(ls "$PROFILES" 2>/dev/null | sed 's/\.conf//' | tr '\n' ' ')(default: $DEFAULT_PROFILE)
Modules : $(ls "$MODULES" 2>/dev/null | tr '\n' ' ')
EOF
}

# === dispatch ================================================================
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
    link)           cmd_link "$@" ;;
    unlink)         cmd_unlink "$@" ;;
    list)           cmd_list "$@" ;;
    adopt)          cmd_adopt "$@" ;;
    status)         cmd_status "$@" ;;
    sync)           cmd_sync "$@" ;;
    install)        cmd_install "$@" ;;
    system-apply)   cmd_system_apply "$@" ;;
    system-pull)    cmd_system_pull "$@" ;;
    build-suckless) cmd_build_suckless "$@" ;;
    fonts)          cmd_fonts "$@" ;;
    nvim-patch)     cmd_nvim_patch "$@" ;;
    audit)          cmd_audit "$@" ;;
