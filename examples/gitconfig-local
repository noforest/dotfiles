# Template for ~/.gitconfig-local, the git identity, never versioned.
# Copy it straight into $HOME and adapt. This file goes through no module, so
# it is neither linked nor tracked. ~/.gitconfig includes it. Without it git
# has no author and refuses to commit.

[user]
  email = ""            # to fill in
  name = ""             # to fill in

# === One account per directory tree =========================================
# Each block overrides [user] under the given directory and picks the matching
# SSH key. The path must end with a "/" to cover the whole tree. The included
# file is not versioned either.
#
# [includeIf "gitdir:~/Documents/programming/<account>/"]
#   path = ~/.gitconfig-<account>
#
# and inside ~/.gitconfig-<account>:
#
# [user]
#     name = <account>
#     email = ""        # to fill in
# [core]
#     sshCommand = "ssh -i ~/.ssh/<key> -o IdentitiesOnly=yes"
