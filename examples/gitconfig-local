# Modèle pour ~/.gitconfig-local — identité git, jamais versionnée.
# Copier directement dans $HOME et adapter : ce fichier ne passe pas par un
# module, il n'est donc ni lié ni suivi. Inclus depuis ~/.gitconfig ; sans lui,
# git n'a pas d'auteur et refuse de committer.

[user]
  email = ""            # à compléter
  name = ""             # à compléter

# ── Un compte par arborescence ──────────────────────────────────────────────
# Chaque bloc surcharge [user] sous le répertoire indiqué, et choisit la clé
# SSH correspondante. Le chemin doit finir par « / » pour couvrir l'arbre.
# Le fichier inclus n'est pas versionné non plus.
#
# [includeIf "gitdir:~/Documents/programming/<compte>/"]
#   path = ~/.gitconfig-<compte>
#
# et dans ~/.gitconfig-<compte> :
#
# [user]
#     name = <compte>
#     email = ""        # à compléter
# [core]
#     sshCommand = "ssh -i ~/.ssh/<clé> -o IdentitiesOnly=yes"
