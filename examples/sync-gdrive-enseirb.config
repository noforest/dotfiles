# Optional overrides for sync-gdrive-enseirb
#
# Copy to ~/.config/sync-gdrive-enseirb/config if the script's defaults do not suit
# you. The file is sourced by bash. Changing any of these makes the next run a
# resync, which merges both sides and deletes nothing.
#
# Every machine sharing the folder must use the same REMOTE.
# Never point either one at what backup-to-gdrive.sh handles (~/Documents,
# gdrive:_BackupsLinux): a two way sync would carry deletions into the backup.

# LOCAL="$HOME/sync-enseirb"
# REMOTE="gdrive-enseirb:sync-enseirb"

# Per file cap, in rclone's size syntax.
# MAX_SIZE="20M"

# The whitelist of extensions is /etc/sync-gdrive-enseirb/filters. To change it on this
# machine, copy it to ~/.config/sync-gdrive-enseirb/filters and edit the copy.
