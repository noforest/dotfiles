# rclone filters for backup-to-gdrive.sh
#
# Copy to ~/.config/backup-to-gdrive/filters, then adapt:
#   mkdir -p ~/.config/backup-to-gdrive
#   cp examples/backup-to-gdrive.filters \
#      ~/.config/backup-to-gdrive/filters
#
# That file stays out of the repository: it holds personal paths.
# Paths are relative to $SRC1 ($HOME/Documents by default).
# Order matters: the first matching rule wins.

# Keep only the attachments of a Zotero library, not the database.
+ zotero/storage/**
- zotero/**

# Git repositories already hosted elsewhere.
# - programming/<github-account>/**

# Large datasets or workspaces that can be regenerated.
# - path/to/project/data/**
