# Template for ~/.zshrc.local, machine specific settings, never versioned.
# Copy it to ~/.zshrc.local and adapt. It is sourced at the end of .zshrc.

# === Completions of local projects ==========================================
# Always guard these with a test. Without it the shell prints an error at
# startup as soon as the project is not there.
# [[ -r ~/Documents/<project>/completion.zsh ]] && \
#     source ~/Documents/<project>/completion.zsh

# === Project variables ======================================================
# export GSL_PATH="$HOME/Documents/<project>/gsl-2.8/install"

# === Directories where `td` fires automatically on `cd` =====================
# TD_AUTO_DIRS=(
#     "$HOME/Documents/<project-a>"
#     "$HOME/Documents/<project-b>"
# )
