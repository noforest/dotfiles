#!/bin/bash
# Template: open a Fortinet VPN tunnel (SAML), then an SSH session behind it.
# Copy it to system/root/usr/local/bin/ and adapt. The real scripts are not
# versioned, because they name internal hosts and third party logins.

REMOTE_USER=""      # to fill in
REMOTE_HOST=""      # to fill in
VPN_CONF="$HOME/.config/openfortivpn.conf"   # not versioned either

if [ -z "$1" ]; then
    echo "Usage: $0 <trusted-cert>"
    exit 1
fi

TRUSTED_CERT="$1"

LOGFILE=$(mktemp)
sudo openfortivpn -c "$VPN_CONF" --saml-login --trusted-cert "$TRUSTED_CERT" > "$LOGFILE" 2>&1 &
VPN_PID=$!
echo "Connecting to the VPN..."
tail -n +1 -f "$LOGFILE" &
TAIL_PID=$!
# Busy wait on the line openfortivpn prints once the tunnel is up.
while ! grep -q "Tunnel is up and running." "$LOGFILE"; do
    inotifywait -e modify -qq "$LOGFILE"
done
kill "$TAIL_PID" 2>/dev/null
echo "Tunnel up, opening SSH..."
ssh "$REMOTE_USER@$REMOTE_HOST"
echo "SSH session closed, tearing down the VPN..."
sudo kill "$VPN_PID"
