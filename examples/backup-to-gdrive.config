# Optional overrides for backup-to-gdrive.sh
#
# Copy to ~/.config/backup-to-gdrive/config if the script's defaults
# do not suit you. The file is sourced by bash.

# SRC1="$HOME/Documents"
# BASE_REMOTE="gdrive:_BackupsLinux"

# Second source, optional: synced without filters to a remote folder
# of the same name. When unset, the script only backs up SRC1.
# SRC2="$HOME/Pictures/some-folder"
