/*
 * Theme of the notification centre (see /usr/local/bin/notification_center).
 *
 * The colours, the font and the frame come as they are from
 * ~/.config/dunst/dunstrc : background #131519, foreground #ffffff,
 * frame_color #aaaaaa, frame_width 3, corner_radius 0.
 *
 * Three deliberate differences:
 *  - the width is 560px and not dunst's 300px, unreadable for a list
 *  - dunst has no selection colour: this takes the blue #698dda, already
 *    used in modules/desktop/.config/flameshot/flameshot.ini. Contrast
 *    5.5:1 on the #131519 background, above the AA threshold
 *  - a #3a4050 separator line sets the two actions apart from the history
 */

* {
    bg:               #131519;
    fg:               #ffffff;
    frame:            #aaaaaa;
    accent:           #698dda;
    muted:            #888888;
    rule:             #3a4050;
    selbg:            #232833;

    background-color: transparent;
    text-color:       @fg;
    font:             "LiterationMono Nerd Font Mono 10";
}

window {
    background-color: @bg;
    border:           3px;
    border-color:     @frame;
    border-radius:    0px;
    width:            560px;
    padding:          8px;
}

mainbox {
    children: [ inputbar, calnav, message, listview ];
    spacing:  6px;
}

inputbar {
    children:     [ prompt, entry ];
    spacing:      8px;
    padding:      2px 2px 6px 2px;
    border:       0 0 1px 0;
    border-color: @frame;   /* dunstrc: separator_color = frame */
}

prompt {
    text-color:       @accent;
    horizontal-align: 0.0;
}

entry {
    placeholder:       "search…";
    placeholder-color: @muted;
    horizontal-align:  0.0;
}

/* ◀ today ▶ above the calendar. Each button triggers the same
   shortcut as Left, Alt+Home, Right: rofi then runs
   notification_center again, which redraws the calendar without closing the window. */
calnav {
    orientation: horizontal;
    expand:      false;
    children:    [ button-prev, dummy, button-today, button-pick, dummy, button-next ];
}

button-prev, button-today, button-pick, button-next {
    expand:     false;
    padding:    2px 10px;
    text-color: @accent;
    cursor:     pointer;
}

button-prev {
    content: "◀";
    action:  "kb-custom-2";
}

button-today {
    content: "today";
    action:  "kb-custom-3";
    padding: 2px 2px 2px 10px;
}

/* ▾ opens the month picker for the year (Alt+Down). The two dummies
   stretching on either side keep today and ▾ together in the middle. */
button-pick {
    content: "▾";
    action:  "kb-custom-5";
    padding: 2px 10px 2px 2px;
}

button-next {
    content: "▶";
    action:  "kb-custom-4";
}

/* -mesg carries the clock + calendar header. The bottom margin keeps the
   last line of `cal` from being clipped by the textbox height rounding. */
message {
    padding: 2px 2px 10px 2px;
    border:  0;
}

/* Centred: every line of `cal` has the same width, so the day
   columns stay aligned. The textbox class also covers the prompt, the
   input and the list rows, which are set back to left alignment. */
textbox {
    text-color:       @fg;
    horizontal-align: 0.5;
}

listview {
    /* -eh 2: each entry takes two lines, so 8 entries = 16 lines */
    lines:        8;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

/* 3px of extra left padding, to make up for the border of the selected
   row and keep the text from jumping by one step on hover. */
element { padding: 4px 6px 4px 9px; }

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.0;
}

/* Dark highlight + accent bar on the left, and not a solid @accent: the
   markup of the two actions already forces their text to @accent, which would become
   invisible on a background of the same colour. Contrasts on #232833: 14.8:1
   for the white text, 4.5:1 for the accent, both above the AA threshold. */
element selected {
    background-color: @selbg;
    text-color:       @fg;
    border:           0 0 0 3px;
    border-color:     @accent;
    padding:          4px 6px 4px 6px;
}
