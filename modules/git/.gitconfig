# Identity and per account routing live in ~/.gitconfig-local, a real file in
# $HOME, outside the repo (neither linked nor tracked).
# Template: examples/gitconfig-local.
[include]
  path = ~/.gitconfig-local

[push]
  default = matching

[pull]
  ff = only

[color]
  #Enable colors in color-supporting terminals
  ui = auto

[alias]
  co = checkout
  st = status
  ci = commit
  glog = log --graph --oneline --decorate=short
[merge]
	conflictstyle = diff3
