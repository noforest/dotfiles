# The tmux window dwm opens at session start (tmuxterm in suckless/dwm/config.h),
# for the desktops that read ~/.config/autostart. dwm does not, so this never
# doubles its own.
[Desktop Entry]
Type=Application
Name=tmux
# A window rather than the maximized one of alacritty.toml, sized in cells.
Exec=alacritty -o "window.startup_mode=\\"Windowed\\"" -o window.dimensions.columns=126 -o window.dimensions.lines=33 -e systemd-run --user --scope --quiet tmux new-session -A -s main
OnlyShowIn=GNOME;
