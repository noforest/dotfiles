#!/bin/sh
#
# dwmblocks block replacing both vap-clock and notification_center.
#
# In the bar : the same "day, time" vap-clock printed.
# On left click, one rofi window holding, top to bottom:
#   - that same day and time
#   - the month calendar, today in red, as vap-clock's notification used to show
#   - the notification centre, with every one of its features
#
# The list and its keys live in notification_center; this script only builds the
# header and hands it over, so there is one implementation of the centre.
#

# Same red as urgency_critical's frame_color in dunstrc.
TODAY_COLOR="#e02f2f"

open_window() {
    # `date +%e` pads single digits with a space, hence the trim. \b keeps the
    # substitution off the year: \b20\b cannot match inside "2026".
    # The awk drops the blank lines `cal` pads its output with, as vap-clock did.
    today=$(date +%e | tr -d ' ')
    calendar=$(cal -m \
        | sed "s/\b$today\b/<b><span color='$TODAY_COLOR'>&<\/span><\/b>/" \
        | awk '{ lines[NR] = $0 }
               END { for (i = 1; i <= NR; i++) if (lines[i] ~ /[^[:space:]]/) last = i
                     for (i = 1; i <= last; i++) print lines[i] }')

    # A real newline: "\n" in double quotes is two literal characters in sh.
    NL='
'
    NC_HEADER="<b>$(date '+%a, %H:%M')</b>$NL$NL<tt>$calendar</tt>"
    export NC_HEADER
    /usr/local/bin/notification_center
}

case "$BUTTON" in
    1) open_window ;;
esac

# The muted bell used to be its own block; kept here so a silenced dunst still
# shows in the bar. Drop the prefix if you would rather not pay a dbus call per
# refresh.
if [ "$(dunstctl is-paused)" = true ]; then
    prefix="󰂛 "
else
    prefix=""
fi

# Uniform dwmblocks padding: one leading space, nothing trailing.
echo " $prefix$(date '+%a, %H:%M')"
