# echo " $icon"


# This script only reacts to a left click (1)
case "$BUTTON" in
    1)
        CHOICE=$(echo -e "Kill dwm\nShutdown\nReboot\nLock & Sleep" | dmenu -i -p "Select an action:")
        case "$CHOICE" in
            "Kill dwm") pkill dwm ;;
            "Shutdown") poweroff ;;
            "Reboot") reboot ;;
            "Lock & Sleep") systemctl suspend ;;
            *) ;;
        esac
        ;;
esac

# Shows an icon for the status bar module (always visible)
icon=" "
echo " $icon"
