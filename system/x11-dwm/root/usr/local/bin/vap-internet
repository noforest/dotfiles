#!/bin/sh

# Show wifi 📶 and percent strength or 📡 if none.
# Show 🌐 if connected to ethernet or ❎ if none.
# Show 🔒 if a vpn connection is active

case $BUTTON in
	1) st -e nmtui ;;
esac



# Name of the Wi-Fi interface, the first wl* one (wlp2s0, wlan0... per machine)
interface=$(ls /sys/class/net | grep -m1 '^wl')


# Function returning the Wi-Fi signal percentage
get_wifi_signal_percentage() {
    local interface=$1
    local signal_strength


    
    signal_strength="$(awk '/^\s*w/ {print int($3 * 100 / 70)}' /proc/net/wireless)"
    
    if [ -n "$signal_strength" ]; then
            echo "$signal_strength"
    else
	    echo "0"  # No signal detected
    fi

}

# Check the Wi-Fi state
if [ -e "/sys/class/net/$interface/operstate" ]; then
    operstate=$(cat /sys/class/net/$interface/operstate)

    if [ "$operstate" = "up" ]; then
        wifi_percentage=$(get_wifi_signal_percentage "$interface")
        
        # Pick the icons from the signal percentage
        if [ "$wifi_percentage" -ge 80 ]; then
            # wifi_icon="󰢾  " # Wi-Fi full
            wifi_icon="󰢾 " # Wi-Fi full
            # wifi_icon="󰤨  " # Wi-Fi full
        elif [ "$wifi_percentage" -ge 40 ]; then
            # wifi_icon="󰢽  "    # Wi-Fi half
            wifi_icon="󰢽 "    # Wi-Fi half
            # wifi_icon="󰤢  "    # Wi-Fi half
        else
            # wifi_icon="󰢼  "  # Wi-Fi empty (for a weak signal)
            wifi_icon="󰢼 "  # Wi-Fi empty (for a weak signal)
            # wifi_icon="󰤟  "  # Wi-Fi empty (for a weak signal)
        fi
        # wifi_status="$wifi_icon${wifi_percentage}% "
        wifi_status="$wifi_icon${wifi_percentage}%"
    else
        # wifi_status=" "
        wifi_status=""
        # wifi_status="󰤮 "
    fi
else
    wifi_status=""  # no Wi-Fi card, a tower on Ethernet
fi

# Check the Ethernet state on any en* interface (the USB adapter name changes with the port).
# A global address, not the carrier: a plugged cable whose connection was
# deactivated in NetworkManager, or still waiting for DHCP, carries no traffic.
ethernet_status=""  # Ethernet disconnected
for d in /sys/class/net/en*; do
    if [ -n "$(ip -o addr show dev "${d##*/}" scope global 2>/dev/null)" ]; then
        ethernet_status="󰈀"  # Ethernet connected
        wifi_status=""  # no Wi-Fi cross while online through Ethernet
        [ "$operstate" = "up" ] && wifi_status="$wifi_icon${wifi_percentage}% / "
        break
    fi
done

# A link can be up without reaching the internet: vap-internet-watch pings
# and leaves this flag while it fails
[ -e "${XDG_RUNTIME_DIR:-/tmp}/internet-offline" ] && offline=" "
# offline=" "
# offline=" 󰈿"

# Show the Wi-Fi icon
echo " $wifi_status$ethernet_status$offline "
# printf "%s%s\u200A\n" " $wifi_status" "$ethernet_status"

