#!/bin/sh
#
# The rofi notification centre for dunst. Not a dwmblocks block of its own:
# clock-notif-center-rofi owns the bar entry and calls this script, which may
# run NC_HEADER_CMD for markup to place above the list. That command gets the
# month offset as its argument, and ◀ today ▶ change that offset.
#
#   type       : filters the history live through rofi's search bar
#   Enter      : pops the selected notification back on screen
#   Control+x  : removes it from the history (also Alt+d)
#   entry 1    : mutes / unmutes dunst
#   entry 2    : clears the whole history
#   Left, Alt+Home, Right (or the ◀ today ▶ buttons of the theme) :
#                previous month, current month, next month. Alt+Left and
#                Alt+Right do the same. The arrows no longer move the cursor in
#                the search bar, Control+b and Control+f still do.
#   Alt+Down (or the ▾ button) : swaps the list for the twelve months of the
#                shown year, ◀ ▶ then change the year and Enter opens a month.
#                ▾ again, or today, goes back to the notifications.
#
# This is a rofi script mode, not dmenu: rofi runs this same file again after
# every action, with ROFI_RETV saying which one, and redraws the window from
# what it prints. So the window stays open while the calendar pages or an entry
# is deleted. Launched without ROFI_RETV, the script starts rofi on itself.
#
# Entries are rendered on two rows, like dunst draws them: bold summary on top,
# body underneath. Script mode splits rows on newlines, so the line break inside
# an entry, and inside the message, is written as the Pango entity &#10;, and
# -eh 2 gives every element two text rows.
#
# The popup is anchored top right, right under the bar.
#
# dunst only keeps `history_length` notifications (dunstrc), so this shows the
# tail of the session, not all of it. Raise that value to see further back.
#
# Note: rofi grabs the keyboard while open, so dwm never sees MODKEY+Shift+s and
# a screenshot cannot be triggered from here. Use `flameshot gui --delay 3000`
# from a terminal and open the centre during the delay.
#

# Calibration: dwm bar height, so the popup hangs just below it. Bump it if the
# bar font changes.
BAR_HEIGHT=24

THEME="$HOME/.config/rofi/notification-center.rasi"

# Kept in step with notification-center.rasi: Pango markup cannot read the
# theme, so the two colours used inline live here as well.
ACCENT="#698dda"
RULE="#3a4050"

if [ -z "$ROFI_RETV" ]; then
    # Control+x is kb-custom-1: plain Delete cannot be used, rofi binds it to
    # kb-remove-char-forward. kb-custom-2 to 5 are also the buttons' actions.
    # Left and Right are taken off the search bar's cursor first: rofi refuses
    # a key bound to two actions.
    exec rofi -show nc -modes "nc:$0" \
        -eh 2 \
        -theme "$THEME" \
        -location 3 -yoffset "$BAR_HEIGHT" -xoffset -4 \
        -kb-custom-1 "Control+x,Alt+d" \
        -kb-move-char-back "Control+b" -kb-move-char-forward "Control+f" \
        -kb-custom-2 "Left,Alt+Left" -kb-custom-3 "Alt+Home" -kb-custom-4 "Right,Alt+Right" \
        -kb-custom-5 "Alt+Down"
fi

# Rofi hands back what the previous run stored with the data option:
# "offset" in the notification list, "offset year" in the month picker.
# Months are counted as year * 12 + month - 1, which makes the offset between
# two of them a plain subtraction.
set -- ${ROFI_DATA:-0}
offset=$1
pick=$2
was_picking=$2
now=$(( $(date +%Y) * 12 + $(date +%-m) - 1 ))

# Row options follow a NUL, fields are split by the unit separator \037.
option() { printf '\000%s\037%s\n' "$1" "$2"; }

case "$pick:$ROFI_RETV" in
    *:12) offset=0 pick= ;;
    ?*:1) offset=$(( ${ROFI_INFO#month:} - now )) pick= ;;
    ?*:11) pick=$((pick - 1)) ;;
    ?*:13) pick=$((pick + 1)) ;;
    ?*:14) pick= ;;
    ?*:*) ;;
    *:14) pick=$(( (now + offset) / 12 )) ;;
    *:1)
        case "$ROFI_INFO" in
            # The signal redraws the clock block (signal 1 in blocks.h) at
            # once, so the muted bell shows up without waiting for its tick.
            mute)  dunstctl set-paused toggle; pkill -RTMIN+1 dwmblocks ;;
            clear) dunstctl history-clear ;;
            *)
                # Printing no rows closes rofi, out of the way of the popup.
                dunstctl history-pop "$ROFI_INFO"
                exit 0
                ;;
        esac
        ;;
    *:10)
        case "$ROFI_INFO" in
            mute|clear) ;;
            *) dunstctl history-rm "$ROFI_INFO" ;;
        esac
        ;;
    *:11) offset=$((offset - 1)) ;;
    *:13) offset=$((offset + 1)) ;;
esac

if [ -n "$pick" ]; then
    hint='<span foreground="#888888">Enter: open month    ◀ ▶: year</span>'
else
    hint='<span foreground="#888888">Enter: show again    Ctrl+x: delete</span>'
fi
if [ -n "$NC_HEADER_CMD" ]; then
    # One line for rofi: the header's newlines become &#10;.
    header=$($NC_HEADER_CMD "$offset" | awk '{ printf "%s&#10;", $0 }')
    mesg="$header$hint"
else
    mesg="$hint"
fi

option prompt "Notifications"
option message "$mesg"
option markup-rows true
# No no-custom: in rofi 2.0 it silently disables use-hot-keys.
option use-hot-keys true
option data "$offset $pick"
# Rofi only honours keep-selection when it is sent from the very first run on,
# so it is always on, and new-selection moves the cursor when it should move.
option keep-selection true

if [ -n "$pick" ]; then
    # Start on the shown month when it is in the picked year.
    shown=$((now + offset))
    if [ $((shown / 12)) -eq "$pick" ]; then
        option new-selection $((shown % 12))
    else
        option new-selection 0
    fi
    # `locale mon` lists the month names of the same locale `cal` uses.
    locale mon | tr ';' '\n' | awk -v y="$pick" '
        { printf "<b>%s %d</b>&#10; \000info\037month:%d\n", $0, y, y * 12 + NR - 1 }'
    exit 0
fi

# After the first draw, keep the cursor and the search where they were. Not
# when leaving the month picker: its filter would hide the notifications.
if [ "$ROFI_RETV" -eq 0 ] || [ -n "$was_picking" ]; then
    option new-selection 0
else
    option keep-filter true
fi

# The two actions are tinted with the accent colour and followed by a rule,
# so they read as controls rather than as the two newest notifications.
if [ "$(dunstctl is-paused)" = true ]; then
    toggle="<b><span foreground=\"$ACCENT\">UNMUTE notifications</span></b>&#10;notifications are muted"
else
    toggle="<b><span foreground=\"$ACCENT\">MUTE notifications</span></b>&#10;silence dunst until toggled back"
fi
wipe="<b><span foreground=\"$ACCENT\">CLEAR history</span></b>&#10;drop every notification below"
rule="<span foreground=\"$RULE\">──────────────  history  ──────────────</span>&#10; "

printf '%s\000info\037mute\n' "$toggle"
printf '%s\000info\037clear\n' "$wipe"
printf '%s\000nonselectable\037true\n' "$rule"

# Bodies carry dunst markup (<b>, <tt>…) and newlines. Strip the tags, keep
# one line, then escape so Pango reads the text as text and not as markup.
# The dunst id rides along as the row's info, so it never shows.
dunstctl history | jq -j '
    .data[0][]
    | ( .summary.data | gsub("<[^>]*>"; "") | gsub("\\s+"; " ") | @html ) as $s
    | ( .body.data    | gsub("<[^>]*>"; "") | gsub("\\s+"; " ") | @html ) as $b
    | "<b>" + $s + "</b>&#10;" + $b + "\u0000info\u001f" + (.id.data | tostring) + "\n"'
