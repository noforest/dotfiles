#!/bin/sh
#
# Run by udev (/etc/udev/rules.d/95-monitor-hotplug.rules) on every DRM event.
# It does not drive xrandr itself: it picks a mode and lets screen_mode apply
# it. The absolute path is mandatory, udev has no /usr/local/bin in its PATH.

# sleep 1

. /usr/local/bin/desktop-env.sh   # sets DESKTOP_USER, USER_HOME, DISPLAY, XAUTHORITY, SCREEN_MODE_FILE

LAPTOP="eDP"

# How long an external screen is allowed to be gone before we call it a real
# unplug. A screen we left without signal goes into standby and drops its HPD,
# which reads exactly like an unplug, but it comes back within a second.
# ponytail: measured under 1s on this monitor, raise it if a slower one flaps.
STANDBY_GRACE=5

# udev runs us as root. Anything touching the user's X session or their files
# under /run/user has to run as the user: a state file left owned by root can no
# longer be written by screen_mode when screen_menu starts it, and the manual
# choice is silently lost.
as_user() {
    if [ "$(id -un)" = "$DESKTOP_USER" ]; then
        "$@"
    else
        runuser -u "$DESKTOP_USER" -- "$@"
    fi
}

# First connected output that is not the internal panel, empty if there is none.
external() {
    xrandr --query | awk -v l="$LAPTOP" '$2 == "connected" && $1 != l {print $1; exit}'
}

# Is that output actually lit, that is does xrandr give it a geometry?
lit() {
    xrandr --query | awk -v o="$1" '
        $1 == o && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {found=1} END {exit !found}'
}

EXTERNAL=$(external)
mode=$(cat "$SCREEN_MODE_FILE" 2>/dev/null)

if [ -n "$EXTERNAL" ]; then
    [ -n "$mode" ] || mode=monitor
    # In laptop mode the layout already is what we want. The screen we left
    # without signal keeps dropping and re-asserting its HPD every few seconds,
    # and re-running xrandr and feh on every bounce would only churn.
    if [ "$mode" = laptop ] && ! lit "$EXTERNAL"; then
        exit 0
    fi
    as_user /usr/local/bin/screen_mode "$mode"
else
    # No external output at all. In laptop mode that is expected rather than an
    # unplug: we switched it off ourselves and it dropped its HPD going into
    # standby. Let it come back before concluding the cable is really out.
    if [ "$mode" = laptop ]; then
        sleep "$STANDBY_GRACE"
        [ -n "$(external)" ] && exit 0
    fi
    # Real unplug: forget the manual choice so that plugging back in starts over
    # on the monitor. The removal comes last, screen_mode rewrites the file.
    as_user /usr/local/bin/screen_mode laptop
    rm -f "$SCREEN_MODE_FILE"
fi
