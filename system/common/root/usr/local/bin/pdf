#!/bin/sh

case "$1" in
    --help|-h)
        echo "Usage: pdf <file>..."
        echo "Wrapper around okular: opens multiple PDFs in a single instance using tabs."
        exit 0
        ;;
    -*)
        echo 'There is no options for the command "pdf"'
        echo "cf pdf --help"
        exit 1
        ;;
    "")
        echo "Usage: pdf <file>..."
        echo "Wrapper around okular: opens multiple PDFs in a single instance using tabs."
        exit 1
        ;;
esac


# One call takes every file: several calls racing each other all find no
# instance yet and each start their own okular.
instance=$(qdbus | awk '/org.kde.okular-/ {print $1; exit}')
if [ -z "$instance" ]; then
    okular "$@" >/dev/null 2>&1 &
else
    for file in "$@"; do
        qdbus "$instance" /okularshell org.kde.okular.openDocument "file://$(realpath "$file")" >/dev/null 2>&1
    done
fi
