// Allows a suspend requested by a program started in the background.
//
// By default, `systemctl suspend` is only granted to a program started from
// the graphical session. But it is acpid that starts xidlehook-start.sh on every
// plug and unplug, and acpid runs outside the session. For
// polkit, the resulting xidlehook belongs to no session: it asks for
// an administrator password, nobody is there to type it, and the
// suspend is dropped without a single message in the journal.
//
// That is why the screen did turn off but the laptop never
// suspended after being unplugged. Turning the screen off goes through
// `xset`, which talks to the X server: X is fine with a cookie, the one
// desktop-env.sh provides with DISPLAY and XAUTHORITY. polkit, on the other hand, looks at
// no file but at the session of the calling process, and a session cannot be
// passed on through environment variables.
//
// Deliberately narrow scope: the wheel group, and only suspend and
// hibernate. Nothing about power off or reboot.

polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.suspend" ||
         action.id == "org.freedesktop.login1.suspend-multiple-sessions" ||
         action.id == "org.freedesktop.login1.hibernate" ||
         action.id == "org.freedesktop.login1.hibernate-multiple-sessions") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
