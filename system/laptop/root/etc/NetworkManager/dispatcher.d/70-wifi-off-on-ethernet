#!/bin/sh
# Turns the wifi off while an Ethernet cable is connected, back on otherwise.
# Being on the same box twice made it hand one address to both interfaces
# (seen on the dock at home), and the wifi was no fallback anyway: it dropped
# at the same second as the cable. NetworkManager runs this as root on every
# connection going up or down, with the interface in $1 and the action in $2.

case "$2" in up|down) ;; *) exit 0 ;; esac

# The cable blinks for a few seconds when the box restarts: wait before
# bringing the wifi back, so that a short drop does not toggle it.
[ "$2" = down ] && sleep 10

if nmcli -t -f TYPE,STATE device | grep -qx 'ethernet:connected'; then
    nmcli radio wifi off
else
    nmcli radio wifi on
fi
