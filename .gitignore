# =============================================================
# Build artefacts
# =============================================================
*.o
*.so
*.so.*
*.a
*.out
*.rej
*.orig

# suckless binaries (explicit paths, otherwise we would ignore the folders)
suckless/dwm/dwm
suckless/st/st
suckless/dmenu/dmenu
suckless/dmenu/stest
suckless/slock/slock
suckless/dwmblocks/dwmblocks

# Backups left behind by `dot link`
*.bak-*

# =============================================================
# Backups and temporary files
# =============================================================
*~
*.swp
*.swo
*.tmp
.DS_Store

# =============================================================
# SECRETS, never to be versioned
# `dot status` fails if any of these patterns enters the index
# =============================================================
**/.ssh/
**/.gnupg/
**/.certs/
**/rclone.conf
**/.npmrc
**/.netrc
**/atuin/config.toml
**/gh/hosts.yml
**/.config/gh/
**/.config/Bitwarden/
**/.mosint.yaml
**/.config/cat_installer/
**/.config/eduroam-script/
**/.config/FortiClient/
**/solaar/config.yaml
**/vlcrc
*.pem
*.key
id_rsa*
id_ed25519*

# =============================================================
# IDENTITY AND INFRASTRUCTURE, on disk but never published
# Only the templates in `examples/` are versioned.
# =============================================================
# Git identity: name, addresses, per-account routing. These files live in
# $HOME, outside of any module, so they are neither linked nor tracked. The
# pattern below is only a safety net against `dot adopt`. It spares
# `.gitconfig`, which stays versioned.
modules/git/.gitconfig-*
# Access to third party infrastructure (VPN tunnel, remote host and login).
# These stay in system/, deployed by `system-apply`, never published.
system/*/root/usr/local/bin/connect_*
system/root/usr/local/bin/connect_*

# Which profile each machine uses. Hostnames stay out of a public repository.
machine.d/*.conf

# =============================================================
# Caches and application state (not configuration)
# =============================================================
**/.cache/
**/node_modules/
**/__pycache__/
**/savedState.conf
**/*.history
**/lazy/
